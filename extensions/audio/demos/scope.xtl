# A live oscilloscope: the synthesizer's music (Instruments.xtl) plays
# while a window draws the samples under the playhead -- the left
# channel above, the right below -- each frame.
# Run: just demo audio scope   (q or close: quit)
"au:" u_se< "Audio"
"in:" u_se< "Instruments"
"cv:" u_se< "Canvas"

# the whole piece, made first: 8 bars side by side (2 by 176384)
first := in:b_ar 1
blen := 2 s_elect s_hape first
u:m_ore := { s -> s c_at_2 in:b_ar 1 + (2 s_elect s_hape s) d_iv blen }
song := 7 'u:m_ore p_ower first
left := 1 s_elect_1 song
right := 2 s_elect_1 song
total := (f_loat t_ally left) / in:rate

w := "Oscilloscope -- X_eTaL" cv:o_pen! 768 384
v := au:o_utput in:rate

# feed bar k+1 when need is 1; how many bars are queued
u:f_eed := { need k ->
  need = 0 ? k
  s := v au:q_ueue! ((k * blen) + r_ange blen) s_elect_2 song
  k + 1
}

# a trace: 256 samples as a 64 by 256 picture, each column lit from
# its sample's row to the next one's, so steep edges stay joined
u:t_race := { x ->
  y := 1 m_ax 64 m_in f_loor 32.5 - 30.0 * x
  z := (1 d_rop y) c_at -1 t_ake y
  r := r_ange 64
  (r '>= t_able y m_in z) * r '<= t_able y m_ax z
}

u:q_uit := { k ->
  x := cv:c_lose! w
  y := au:c_lose! v
  -1
}

# a frame: an event, the playhead, more music when less than 0.6 s is
# queued, and the 512 samples from the playhead (every other one) drawn
u:f_rame := { k ->
  k < 0 ? k
  e := cv:n_ext! w
  ((e m_atch "close") + e m_atch "key q") > 0 ? u:q_uit k
  p := au:p_layed v
  p >= total ? u:q_uit k
  ahead := ((f_loat k * blen) / in:rate) - p
  k2 := ((k < 8) * ahead < 0.6) u:f_eed k
  i := 1 m_ax (t_ally left) m_in (f_loor p * in:rate) + 2 * r_ange 256
  s := w cv:s_how! (u:t_race i s_elect left) c_at u:t_race i s_elect right
  k2
}
last := 100000 'u:f_rame p_ower 1 u:f_eed 0
"bye"
