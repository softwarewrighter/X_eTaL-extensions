# A synthesizer made of arrays: X_eTaL computes every sample of a little
# piece -- notes from equal temperament, harmonics, envelopes, chords,
# stereo -- and the audio extension plays them as they are made.
# Run: just demo audio synth
"au:" u_se< "Audio"

rate := 22050.0
v := au:o_utput rate

# a note's pitch: k semitones above A4 (440 Hz)
u:h_z := { k -> 440.0 * 2.0 ^ (f_loat k) / 12.0 }

# the times of the samples of a 0.25 s step, and its envelope: a quick
# attack, a decay toward 60%, and a release at the end
n := f_loor 0.25 * rate
t := (f_loat (r_ange n) - 1) / rate
env := (1.0 m_in t / 0.01) * (((0.25 - t) / 0.06) m_in 1.0) * 0.6 + 0.4 * e_xp 0.0 - t / 0.12

# a tone: three harmonics (1, 1/2, 1/4) at each frequency of f, one row
# per frequency, along the times tt
u:t_one := { f tt ->
  x := 6.283185307179586 * f '* t_able tt
  (s_in x) + (0.5 * s_in 2.0 * x) + 0.25 * s_in 3.0 * x
}

# the chords, as semitones from A4: C, Am, F, G (four notes each)
chords := 4 4 r_eshape -9 -5 -2 3  -12 -9 -5 0  -16 -12 -9 -4  -14 -10 -7 -2

# a bar: the chord's notes in turn (one row each, enveloped, then laid
# end to end), over its root two octaves down for the whole bar, mixed
# to stereo: the arpeggio more to the right, the bass more to the left
u:b_ar := { b ->
  k := (1 + (b - 1) m_od 4) s_elect_1 chords
  mel := r_avel 0.2 * ((u:h_z k) u:t_one t) * (4 c_at n) r_eshape env
  tb := (f_loat (r_ange 4 * n) - 1) / rate
  low := r_avel (u:h_z (f_irst k) - 24) u:t_one tb
  bass := 0.25 * low * (1.0 m_in tb / 0.02) * ((1.0 - tb) / 0.1) m_in 1.0
  1.5 * (2 c_at 4 * n) r_eshape ((0.7 * bass) + 0.3 * mel) c_at (0.3 * bass) + 0.7 * mel
}

# play eight bars, each made while the one before is sounding
u:p_lay := { b ->
  s := v au:q_ueue! u:b_ar b
  w := v au:w_ait! 0.5
  b + 1
}
last := 8 'u:p_lay p_ower 1
c := au:c_lose! v
"played 8 bars (8 seconds), every sample computed in X_eTaL"
