command = "rm -rf work && XETAL_HEADLESS=1 XETAL_EVENTS=frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame XETAL_FRAMES=work/frames XETAL_AUDIO_WAV=work/scope.wav xetal-x --ext .. run demos/scope.xtl && cksum work/frames/canvas-1-10.png work/frames/canvas-1-40.png work/scope.wav"
exit_code = 0
desc = "the oscilloscope with no window and no sound device: 40 frames of the waveform under the playhead, two pinned, and the sound it queued"
