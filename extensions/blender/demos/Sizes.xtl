## Sizes.xtl -- the size comparison, xkcd style, as a Blender scene: one
## cube, a 10 by 10 slab of a hundred, a 10 by 10 by 10 block of a
## thousand, side by side on the ground and labeled, the camera going
## once round them. Shared by the demo (demos/cubes.xtl: the video) and
## its test (a few tiny frames).
## Import: "sz:" u_se< "Sizes"

"bp:" u_se< "Bpy"

### The cubes

# every cell of an a by b by c block, x slowest, 0-based, as n by 3
h:c_ells := { abc ->
  n := '* r_/ abc
  i := (r_ange n) - 1
  c := 3 s_elect abc
  b := 2 s_elect abc
  2 1 t_ranspose (3 c_at n) r_eshape (i d_iv b * c) c_at ((i d_iv c) m_od b) c_at i m_od c
}

## the three groups' centers (n by 3, z up, on the ground at z 0): one
## cube at x -10; a hundred, 10 by 10 on the ground, about x 0; a
## thousand, 10 by 10 by 10, about x 16 -- a block a step apart, the
## cubes 0.9 wide so each shows
## >> "sz:" u_se< "Sizes"
## >> (1 s_elect s_hape sz:one) c_at (1 s_elect s_hape sz:hundred) c_at 1 s_elect s_hape sz:thousand
## 1 100 1000
l:one := 1 3 r_eshape -10.0 0.0 0.5
## a hundred: 10 by 10 on the ground, about x 0
l:hundred := (f_loat h:c_ells 10 10 1) + 100 3 r_eshape -4.5 -4.5 0.5
## a thousand: 10 by 10 by 10, about x 16
l:thousand := (f_loat h:c_ells 10 10 10) + 1000 3 r_eshape 11.5 -4.5 0.5

### The scene

## (width, height, frames) sz:s_cene 0: the whole script Blender runs:
## the three groups, a label before each, the ground, a pale sky and a
## sun, the camera going once round in the frames, EEVEE at that size;
## then the exports and the report. The video is left to the caller
## (bp:v_ideo or bp:s_till), added after.
l:s_cene := { (w, h, frames) z ->
  blue := 0.42 0.62 0.9
  ink := 0.08 0.08 0.1
  t := bp:head c_at (("one", l:one, 0.9, blue) bp:c_ubes 0) c_at (("hundred", l:hundred, 0.9, blue) bp:c_ubes 0) c_at (("thousand", l:thousand, 0.9, blue) bp:c_ubes 0)
  t := t c_at (("1", -10.0 -3.0 0.0, 1.6, ink) bp:l_abel 0) c_at (("100", 0.0 -7.5 0.0, 1.6, ink) bp:l_abel 0) c_at (("1000", 16.0 -7.5 0.0, 1.6, ink) bp:l_abel 0)
  t := t c_at ((3.0 0.0 0.0, 200.0, 0.97 0.97 0.95) bp:g_round 0) c_at ((0.55 0.62 0.72, 3.0) bp:l_ights 0)
  t := t c_at ((3.0 0.0 3.0, 42.0, 20.0, frames) bp:o_rbit 0) c_at ((w, h, 24) bp:s_etup 0)
  t c_at (bp:e_xports "sizes") c_at bp:report
}
