## Blender, ray-traced: a city at night after rain, flown through. The
## city is arrays (NeonCity.xtl): 240 lots, each tower's height,
## footprint and skin from a hash of its number; screens, neon, lamps,
## steam, bridges, cars and fliers, all rows of tables that Cycles.xtl
## writes into Blender's Python. Here: four stills along the camera's
## flight, 1280 by 720, ray-traced by Cycles (the graphics card when
## there is one), written to work/city/out.
## Run: just demo blender city   (about five minutes)
## Title: The neon city, ray-traced: four stills
## Link: three/live/ the same city, live: fly and walk through it

"bl:" u_se< "Blender"
"bp:" u_se< "Bpy"
"cy:" u_se< "Cycles"
"nc:" u_se< "NeonCity"

script := (((1280, 720, 30, 64, "GPU") nc:s_cene 0) c_at
  (("skyline.png", 0.5) cy:s_till 0) c_at (("descent.png", 6.0) cy:s_till 0) c_at (("street.png", 10.5) cy:s_till 0) c_at ("screen.png", 14.5) cy:s_till 0)
_ := "work/city/run.py" bl:w_rite! bp:launcher
_ := "work/city/scene.py" bl:w_rite! script
"ray tracing four stills with Blender (Cycles) ..."
r := "work/city/run.py" bl:r_un! "work/city/scene.py work/city/out"
"the run, and the error lines in Blender's log:"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
"what Blender made:"
bl:r_ead "work/city/out/report.txt"
"the files (bytes, path):"
bl:f_iles "work/city/out"
