## Blender, 4: game assets. X_eTaL makes the twelve tower defense pieces
## for X_eTaL-games and everything published with them: it writes the
## Python -- the launcher, and the bpy script describing each piece
## (Td.xtl) -- Python runs Blender, Blender runs the script: each piece
## is written as NAME.glb with its clips, rendered alone as NAME.png,
## shown close, one after another, turning and playing each clip, for
## one video, and all twelve lined up for another. Then X_eTaL hashes every file (the digest extension) into
## manifest.toml and writes the page that shows them, index.html, all
## in work/td/site. just ext blender publish-td copies that into the
## site, at blender/td/.
## Page: blender/td/ the pieces in 3D (published)
## Run: just demo blender game-assets   (about five minutes)

"bl:" u_se< "Blender"
"bp:" u_se< "Bpy"
"td:" u_se< "Td"

## the pieces' Python, then each rendered alone, then two videos (960
## by 540): the pieces one after another, close, 5 seconds each, and
## all twelve lined up, 8 seconds
script := bp:head c_at td:all c_at bp:report c_at ((0.55 0.62 0.72, 3.0) bp:l_ights 0) c_at td:show
script := script c_at (td:s_tills 320) c_at ((0.0 0.0 0.0, 30.0, 0.042 0.205 0.058) bp:g_round 0)
script := script c_at ((960, 540, 150) td:c_loseups 0) c_at (bp:v_ideo "../closeups.mp4") c_at ((960, 540, 240) td:f_ilm 0) c_at bp:v_ideo "../lineup.mp4"
n := "work/td/run.py" bl:w_rite! bp:launcher
n := "work/td/assets.py" bl:w_rite! script
"X_eTaL -> python -> Blender -> python: twelve pieces, their pictures, a video ..."
r := "work/td/run.py" bl:r_un! "work/td/assets.py work/td/site"
"the run, and the error lines in Blender's log:"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
"each piece's clips, read back from its .glb:"
bl:r_ead "work/td/site/clips.txt"
"the manifest (every file hashed) and the page:"
m := "work/td/site/manifest.toml" bl:w_rite! ("work/td/site", bl:v_ersion @) td:m_anifest 0
p := "work/td/site/index.html" bl:w_rite! td:page
bl:r_ead "work/td/site/manifest.toml"
"the files (bytes, path):"
bl:f_iles "work/td/site"
