schedule: Float as float, Int as long, work-group 256, products and transposes in 16 by 16 tiles
buffers:
  b_a: long 12 items, %a i64 [3 4]; constant, uploaded by the host
  b_b: long 8 items, %b i64 [4 2]; constant, uploaded by the host
  b_mm: long 6 items, %mm i64 [3 2]; written on the device
  b_b_2: long 4 items, %b_2 i64 [4]; constant, uploaded by the host
  b_mm_2: long 3 items, %mm_2 i64 [3]; written on the device
  b_a_2: long 3 items, %a_2 i64 [3]; constant, uploaded by the host
  b_mm_3: long 4 items, %mm_3 i64 [4]; written on the device
  b_l: float 12 items, %l f64 [3 4]; constant, uploaded by the host
  b_l_2: float 12 items, %l_2 f64 [4 3]; constant, uploaded by the host
  b_div: float 12 items, %div f64 [3 4]; written on the device
  b_div_2: float 12 items, %div_2 f64 [4 3]; written on the device
  b_mm_4: float 9 items, %mm_4 f64 [3 3]; written on the device
kernels:
  matmul_tiled16_long: sums of products in tiles staged in local memory, folded from the right; computes %mm %mm_2 %mm_3
  k0: 12 elements, one work-item each; computes %div; writes %div
  k1: 12 elements, one work-item each; computes %div_2; writes %div_2
  matmul_tiled16_float: sums of products in tiles staged in local memory, folded from the right; computes %mm_4
launches:
  1: matmul_tiled16_long(b_a, b_b, b_mm, 3, 4, 2) global 256 local 256: %mm: 3 by 4 times 4 by 2 in 16 by 16 tiles: 1 work-group of 256
  2: matmul_tiled16_long(b_a, b_b_2, b_mm_2, 3, 4, 1) global 256 local 256: %mm_2: 3 by 4 times 4 by 1 in 16 by 16 tiles: 1 work-group of 256
  3: matmul_tiled16_long(b_a_2, b_a, b_mm_3, 1, 3, 4) global 256 local 256: %mm_3: 1 by 3 times 3 by 4 in 16 by 16 tiles: 1 work-group of 256
  4: k0(b_l, b_div) global 16 local 16: 12 elements (1 group of 16)
  5: k1(b_l_2, b_div_2) global 16 local 16: 12 elements (1 group of 16)
  6: matmul_tiled16_float(b_div, b_div_2, b_mm_4, 3, 4, 3) global 256 local 256: %mm_4: 3 by 4 times 4 by 3 in 16 by 16 tiles: 1 work-group of 256
outputs:
  %mm from b_mm, read back by the host
  %mm_2 from b_mm_2, read back by the host
  %mm_3 from b_mm_3, read back by the host
  %mm_4 from b_mm_4, read back by the host
from:
  matmul_tiled16_long: 8: a ac:m_atmul b | 9: a ac:m_atmul 1 -1 1 -1 | 10: 1 2 3 ac:m_atmul a
  k0: 11: f := (3 4 r_eshape r_ange 12) / 4
  k1: 12: g := (4 3 r_eshape r_ange 12) / 8
  matmul_tiled16_float: 13: f ac:m_atmul g
