## Blender, 9: HEX1000's program counter, an explainer made with the
## kit. The 64 addresses of a ROM page as cells in reading order; the
## program counter visits them in its shift register's order -- 0 1 3 7
## 15 31 63 62 ..., never +1 -- each cell lit as it is reached, colored
## by when, the path drawn behind. The order is X_eTaL-fpga's Hex1000
## library (pinned at FPGA_COMMIT); the first hops in slow motion, the
## rest a time-lapse, after a title card, with captions. Made twice --
## a YouTube video (1920 by 1080) and a Short (1080 by 1920) -- with a
## cue sheet and subtitles (.srt) to record narration against
## (PcWalk.xtl).
## Run: just demo blender hex-pc   (a few minutes: 586 frames, twice)

"bl:" u_se< "Blender"
"bp:" u_se< "Bpy"
"vd:" u_se< "Video"
"pw:" u_se< "PcWalk"

n := "work/hexpc/run.py" bl:w_rite! bp:launcher
n := "work/hexpc/hex-pc.cues.toml" bl:w_rite! (pw:cueTexts, pw:cueTable) vd:c_ues 0
n := "work/hexpc/hex-pc.srt" bl:w_rite! (pw:cueTexts, pw:cueTable) vd:s_rt 0
"the cue sheet (work/hexpc/hex-pc.cues.toml):"
bl:r_ead "work/hexpc/hex-pc.cues.toml"
n := "work/hexpc/video.py" bl:w_rite! (pw:s_cene vd:landscape) c_at (vd:r_ender "hex-pc.mp4") c_at vd:report
n := "work/hexpc/short.py" bl:w_rite! (pw:s_cene vd:shorts) c_at (vd:r_ender "hex-pc-short.mp4") c_at vd:report
"rendering 586 frames at 1920 by 1080 with Blender (EEVEE) ..."
r := "work/hexpc/run.py" bl:r_un! "work/hexpc/video.py work/hexpc/out"
"the run, and the error lines in Blender's log:"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
"rendering the Short, 586 frames at 1080 by 1920 ..."
r := "work/hexpc/run.py" bl:r_un! "work/hexpc/short.py work/hexpc/out-short"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
"what Blender made:"
bl:r_ead "work/hexpc/out/report.txt"
"the files (bytes, path):"
bl:f_iles "work/hexpc"
