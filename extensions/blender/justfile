# blender -- Blender 3D in batch: run Python that runs Blender. `just` lists recipes.
# Run from this directory (or `just ext blender RECIPE` from the repo root).

set positional-arguments

root := "../.."

# List the recipes
default:
    @just --list

# Build the native library (target/debug/libxetal_ext_blender.dylib or .so) and xetal-x
build:
    cd {{root}} && cargo build -q --workspace

# Rust tests  and the reg-rs tests
test: test-rust reg

# Rust tests of the crate in rust/
test-rust:
    cargo test -q -p xetal-ext-blender

# reg-rs tests in tests/ (baselines committed there)
reg:
    {{root}}/scripts/reg-ext.sh blender run

# Show the reg-rs failures in full
reg-diff:
    {{root}}/scripts/reg-ext.sh blender run -vv

# Accept the latest output of one reg-rs test as its baseline (review the diff)
rebase test:
    {{root}}/scripts/reg-ext.sh blender rebase -p "$1"

# The functions this extension exports, as xetal-x sees them
list: build
    {{root}}/target/debug/xetal-x --ext . --ext-list

# Run a demo: just demo NAME (demos/NAME.xtl; pictures go to work/draw/; the shared libraries on XETAL_PATH)
demo name: build
    XETAL_PATH="$({{root}}/scripts/libraries.sh)" {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw "demos/$1.xtl"

# The HEX1000 video: the board simulated (iverilog), the browser calculator typed at (headless Chrome), then demos/hex-run.xtl renders (about 25 minutes)
hex-run: build
    {{root}}/scripts/hex1000-sim.sh "C0DE+BEEF=" work/hexrun
    {{root}}/.venv/bin/python3 {{root}}/scripts/hex1000-browser.py "C0DE+BEEF=" work/hexrun
    XETAL_PATH="$({{root}}/scripts/libraries.sh)" {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw demos/hex-run.xtl

# Synthesize, place, route and pack the pinned board; OSS CAD Suite on PATH
hex-build-data:
    {{root}}/.venv/bin/python3 {{root}}/scripts/hex1000-build.py work/hexbuild

# Validate the build-evidence reader, including incomplete placement and routing
hex-build-check:
    {{root}}/.venv/bin/python3 tests/hex-build-data.py

# Full physical 1K calculator evidence: model/RTL tests, synthesis, route and pack
hex-keys-leds-evidence:
    {{root}}/scripts/xetal.sh > /dev/null
    {{root}}/.venv/bin/python3 tools/keys-leds-evidence.py work/keys-leds-evidence

# The same pinned models and complete board simulations, without synthesis
hex-keys-leds-sim:
    {{root}}/scripts/xetal.sh > /dev/null
    {{root}}/.venv/bin/python3 tools/keys-leds-evidence.py work/keys-leds-sim --simulate-only

# Negative checks for reviewed pins, row-enable polarity and clock timing
hex-keys-leds-check:
    {{root}}/.venv/bin/python3 tests/keys-leds-evidence.py

# Verify the saved evidence against current pins, input copies and artifact hashes
hex-keys-leds-verify:
    {{root}}/.venv/bin/python3 tools/keys-leds-evidence.py work/keys-leds-evidence --verify-only

# The build-process video and Short, from the actual tool artifacts (headless)
hex-build: hex-build-data
    {{root}}/scripts/demos.sh blender hex-build

# Refresh UART opening cards/cues, preserving footage, URLs and original inputs
uart-titles:
    cd {{root}} && cargo build -q --release --workspace
    {{root}}/scripts/hex1000-sim.sh "C0DE+BEEF=" work/hexrun
    {{root}}/.venv/bin/python3 tools/uart-titles.py
    HEX_RUN_VIDEO=work/uart-titles/hex-run.mp4 {{root}}/scripts/videos.sh blender hex-run
    HEX_BUILD_VIDEO=work/uart-titles/hex-build.mp4 {{root}}/scripts/videos.sh blender hex-build

# Publish the tower defense pieces demos/game-assets.xtl made on the site (pages/blender/td)
publish-td:
    {{root}}/scripts/publish-td.sh

# Play the orbit video demos/cubes.xtl rendered (work/cubes/out/orbit.mp4), without rendering it again
orbit:
    @[ -f work/cubes/out/orbit.mp4 ] || { echo "no orbit yet: just demo blender cubes renders it (about five minutes)"; exit 1; }
    open work/cubes/out/orbit.mp4 2>/dev/null || xdg-open work/cubes/out/orbit.mp4
