# blender -- Blender 3D in batch: run Python that runs Blender. `just` lists recipes.
# Run from this directory (or `just ext blender RECIPE` from the repo root).

set positional-arguments

root := "../.."

# List the recipes
default:
    @just --list

# Build the native library (target/debug/libxetal_ext_blender.dylib or .so) and xetal-x
build:
    cd {{root}} && cargo build -q --workspace

# Rust tests  and the reg-rs tests
test: test-rust reg

# Rust tests of the crate in rust/
test-rust:
    cargo test -q -p xetal-ext-blender

# reg-rs tests in tests/ (baselines committed there)
reg:
    {{root}}/scripts/reg-ext.sh blender run

# Show the reg-rs failures in full
reg-diff:
    {{root}}/scripts/reg-ext.sh blender run -vv

# Accept the latest output of one reg-rs test as its baseline (review the diff)
rebase test:
    {{root}}/scripts/reg-ext.sh blender rebase -p "$1"

# The functions this extension exports, as xetal-x sees them
list: build
    {{root}}/target/debug/xetal-x --ext . --ext-list

# Run a demo: just demo NAME (demos/NAME.xtl; pictures go to work/draw/; the shared libraries on XETAL_PATH)
demo name: build
    XETAL_PATH="$({{root}}/scripts/libraries.sh)" {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw "demos/$1.xtl"

# The HEX1000 video: the board simulated (iverilog), the browser calculator typed at (headless Chrome), then demos/hex-run.xtl renders (about 25 minutes)
hex-run: build
    {{root}}/scripts/hex1000-sim.sh "C0DE+BEEF=" work/hexrun
    {{root}}/.venv/bin/python3 {{root}}/scripts/hex1000-browser.py "C0DE+BEEF=" work/hexrun
    XETAL_BLENDER_TIMEOUT="${XETAL_BLENDER_TIMEOUT:-3600}" XETAL_PATH="$({{root}}/scripts/libraries.sh)" {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw demos/hex-run.xtl

# Synthesize, place, route and pack the pinned board; OSS CAD Suite on PATH
hex-build-data:
    {{root}}/.venv/bin/python3 {{root}}/scripts/hex1000-build.py work/hexbuild

# Validate the build-evidence reader, including incomplete placement and routing
hex-build-check:
    {{root}}/.venv/bin/python3 tests/hex-build-data.py

# Full physical 1K calculator evidence: model/RTL tests, synthesis, route and pack
hex-keys-leds-evidence:
    {{root}}/scripts/xetal.sh > /dev/null
    {{root}}/.venv/bin/python3 tools/keys-leds-evidence.py work/keys-leds-evidence

# The same pinned models and complete board simulations, without synthesis
hex-keys-leds-sim:
    {{root}}/scripts/xetal.sh > /dev/null
    {{root}}/.venv/bin/python3 tools/keys-leds-evidence.py work/keys-leds-sim --simulate-only

# Negative checks for reviewed pins, row-enable polarity and clock timing
hex-keys-leds-check:
    {{root}}/.venv/bin/python3 tests/keys-leds-evidence.py

# Verify the saved evidence against current pins, input copies and artifact hashes
hex-keys-leds-verify:
    {{root}}/.venv/bin/python3 tools/keys-leds-evidence.py work/keys-leds-evidence --verify-only

# The physical 1K execution: contacts, full model replay, SPI, video and Short
hex-keys-leds-run:
    {{root}}/scripts/xetal.sh > /dev/null
    bash {{root}}/scripts/hex1000.sh > /dev/null
    cd {{root}} && cargo build -q --release --workspace
    {{root}}/.venv/bin/python3 tools/keys-leds-run.py prepare
    {{root}}/.venv/bin/python3 tools/keys-leds-run.py render

# Six critical stills in each shape, from an existing checked simulation
hex-keys-leds-preview:
    {{root}}/.venv/bin/python3 tools/keys-leds-run.py preview

# Reject malformed MAX7219 transactions in the waveform adapter
hex-keys-leds-wave-check:
    {{root}}/.venv/bin/python3 tests/keys-leds-wave.py

# The build-process video and Short, from the actual tool artifacts (headless)
hex-build: hex-build-data
    XETAL_BLENDER_TIMEOUT="${XETAL_BLENDER_TIMEOUT:-3600}" {{root}}/scripts/demos.sh blender hex-build

# Full 1K build and verified scene arrays, then landscape and Short
hex-keys-leds-build: hex-keys-leds-evidence
    {{root}}/.venv/bin/python3 tools/keys-leds-build.py
    XETAL_BLENDER_TIMEOUT=3600 {{root}}/scripts/demos.sh blender hex-keys-leds-build

# Recheck existing build artifacts and export their actual BEL/tile arrays
hex-keys-leds-build-data:
    {{root}}/.venv/bin/python3 tools/keys-leds-build.py

# Six actual build stages in both shapes, before the full render
hex-keys-leds-build-preview: hex-keys-leds-build-data
    XETAL_BLENDER_TIMEOUT=3600 XETAL_PATH="demos:lib:{{root}}/lib:{{root}}/work/hex1000/libs/Panel/src:{{root}}/work/hex1000/libs/Hex1000/src:{{root}}/work/hex1000/libs/Radix/src:{{root}}/work/hex1000-libraries/libs/Strings/src" {{root}}/target/release/xetal-x --ext {{root}}/extensions run tests/keys-build-quick.xtl

# Focused malformed-placement, resource, route and clock checks
hex-keys-leds-build-check:
    {{root}}/.venv/bin/python3 tests/keys-leds-build.py

# Verify both families' four videos, exports, cues/SRT and stage samples
hex-release-check:
    {{root}}/scripts/check-busy.sh
    {{root}}/.venv/bin/python3 tools/hex-release.py

# Build the pinned GPU compiler in isolation and extract actual artifacts
gpu-build-data:
    bash {{root}}/scripts/gpu-video-tool.sh
    {{root}}/.venv/bin/python3 tools/gpu-build.py

# Commit-ready Core, XIR, profiles, compiler plans and real emitted kernels
gpu-build-sources: gpu-build-data
    {{root}}/.venv/bin/python3 tools/gpu-build.py publish

# Verify existing compiler sources, outputs and tool hashes
gpu-build-verify:
    {{root}}/.venv/bin/python3 tools/gpu-build.py verify

# Source-to-OpenCL movie and Short, using verified compiler artifacts
gpu-build: gpu-build-sources
    XETAL_BLENDER_TIMEOUT="${XETAL_BLENDER_TIMEOUT:-3600}" {{root}}/scripts/demos.sh blender gpu-build

# Critical compiler stages, both shapes, from existing verified data
gpu-build-preview: gpu-build-verify
    XETAL_BLENDER_TIMEOUT=3600 XETAL_PATH="demos:lib:{{root}}/lib" {{root}}/target/release/xetal-x --ext {{root}}/extensions run tests/gpu-build-quick.xtl

# Negative compiler-evidence parser checks
gpu-build-check:
    {{root}}/.venv/bin/python3 tests/gpu-build-data.py

# Collect actual OpenCL events and independent pinned runtime results
gpu-run-data: gpu-build-sources
    {{root}}/.venv/bin/python3 tools/gpu-run.py collect
    {{root}}/.venv/bin/python3 tools/gpu-run.py publish

# Existing captured inputs, outputs and event timestamps must still agree
gpu-run-verify:
    {{root}}/.venv/bin/python3 tools/gpu-run.py verify

# Render the checked observation, without recollecting different timings
gpu-run: gpu-run-verify
    XETAL_BLENDER_TIMEOUT="${XETAL_BLENDER_TIMEOUT:-3600}" {{root}}/scripts/demos.sh blender gpu-run

# Six stages in both formats, before the full render
gpu-run-preview: gpu-run-verify
    XETAL_BLENDER_TIMEOUT=3600 XETAL_PATH="demos:lib:{{root}}/lib" {{root}}/target/release/xetal-x --ext {{root}}/extensions run tests/gpu-run-quick.xtl

# Malformed timestamp, transfer, output and host timing guards
gpu-run-check:
    {{root}}/.venv/bin/python3 tests/gpu-run-data.py

# Refresh UART opening cards/cues, preserving footage, URLs and original inputs
uart-titles:
    cd {{root}} && cargo build -q --release --workspace
    {{root}}/scripts/hex1000-sim.sh "C0DE+BEEF=" work/hexrun
    {{root}}/.venv/bin/python3 tools/uart-titles.py
    HEX_RUN_VIDEO=work/uart-titles/hex-run.mp4 {{root}}/scripts/videos.sh blender hex-run
    HEX_BUILD_VIDEO=work/uart-titles/hex-build.mp4 {{root}}/scripts/videos.sh blender hex-build

# Publish the tower defense pieces demos/game-assets.xtl made on the site (pages/blender/td)
publish-td:
    {{root}}/scripts/publish-td.sh

# Play the orbit video demos/cubes.xtl rendered (work/cubes/out/orbit.mp4), without rendering it again
orbit:
    @[ -f work/cubes/out/orbit.mp4 ] || { echo "no orbit yet: just demo blender cubes renders it (about five minutes)"; exit 1; }
    open work/cubes/out/orbit.mp4 2>/dev/null || xdg-open work/cubes/out/orbit.mp4
