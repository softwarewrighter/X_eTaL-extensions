the launcher:
import os, subprocess, sys
blender = os.environ.get("XETAL_BLENDER") or sys.exit("no Blender found")
run = [blender, "--background", "--factory-startup", "--python-exit-code", "1", "--python", sys.argv[1], "--"] + sys.argv[2:]
sys.exit(subprocess.run(run).returncode)

the scene:
import bpy, math, os, sys
args = sys.argv[sys.argv.index("--") + 1:]
out = args[0]
os.makedirs(out, exist_ok=True)
bpy.ops.wm.read_factory_settings(use_empty=True)
bpy.context.preferences.edit.keyframe_new_interpolation_type = "LINEAR"
scene = bpy.context.scene
scene.render.fps = 30

def nums(text, k):
    v = [float(t) for t in text.split()]
    return [tuple(v[i:i + k]) for i in range(0, len(v), k)]

def material(name, rgb, emit=0.0):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    p = m.node_tree.nodes["Principled BSDF"]
    p.inputs["Base Color"].default_value = rgb + (1.0,)
    p.inputs["Emission Color"].default_value = rgb + (1.0,)
    p.inputs["Emission Strength"].default_value = emit
    return m

def link(obj, mat):
    scene.collection.objects.link(obj)
    obj.data.materials.append(mat)
    return obj

def piece(name):
    p = bpy.data.objects.new(name, None)
    scene.collection.objects.link(p)
    return p

def made(name):
    o = bpy.context.active_object
    o.name = name
    o.data.name = name
    return o

def mesh_object(name, verts, faces):
    m = bpy.data.meshes.new(name)
    m.from_pydata(verts, [], faces)
    m.validate()
    m.update()
    o = bpy.data.objects.new(name, m)
    scene.collection.objects.link(o)
    return o

def attach(obj, owner, mat, at, turn):
    obj.parent = owner
    obj.location = at
    obj.rotation_euler = tuple(math.radians(a) for a in turn)
    obj.data.materials.clear()
    obj.data.materials.append(mat)
    return obj

actions = {}

def keys(name, clip, path, times, values):
    o = bpy.data.objects[name]
    if o.animation_data is None:
        o.animation_data_create()
    act = actions.get((name, clip))
    if act is None:
        act = bpy.data.actions.new(name + " " + clip)
        actions[(name, clip)] = act
    rest = tuple(getattr(o, path))
    o.animation_data.action = act
    for t, v in zip(times, values):
        if path == "rotation_euler":
            v = tuple(math.radians(a) for a in v)
        setattr(o, path, v)
        o.keyframe_insert(data_path=path, frame=round(t * scene.render.fps))
    o.animation_data.action = None
    setattr(o, path, rest)

def clips():
    for (name, clip), act in actions.items():
        o = bpy.data.objects[name]
        if not any(t.name == clip for t in o.animation_data.nla_tracks):
            t = o.animation_data.nla_tracks.new()
            t.name = clip
            t.strips.new(clip, 0, act)

def glb_clips(path):
    import json, struct
    data = open(path, "rb").read()
    g = json.loads(data[20:20 + struct.unpack("<I", data[12:16])[0]])
    found = []
    for a in g.get("animations", []):
        times = [g["accessors"][s["input"]] for s in a["samplers"]]
        what = sorted("%s %s" % (g["nodes"][c["target"]["node"]]["name"], c["target"]["path"]) for c in a["channels"])
        found.append("clip %s %.2f-%.2f s: %s" % (a["name"], min(t["min"][0] for t in times), max(t["max"][0] for t in times), ", ".join(what)))
    return found

def export_piece(owner, path):
    clips()
    bpy.ops.object.select_all(action="DESELECT")
    owner.select_set(True)
    for c in owner.children_recursive:
        c.select_set(True)
    bpy.context.view_layer.objects.active = owner
    bpy.ops.export_scene.gltf(filepath=path, export_format="GLB", use_selection=True, export_animations=True, export_animation_mode="NLA_TRACKS")

def triangles(owner):
    return sum(sum(len(p.vertices) - 2 for p in c.data.polygons) for c in owner.children_recursive if c.type == "MESH")

mesh = bpy.data.meshes.new("one")
mesh.from_pydata(nums("""-0.45 -0.45 0.04999999999999999 0.45 -0.45 0.04999999999999999 0.45 0.45 0.04999999999999999 -0.45 0.45 0.04999999999999999 -0.45 -0.45 0.95 0.45 -0.45 0.95 0.45 0.45 0.95 -0.45 0.45 0.95""", 3), [], [tuple(int(i) for i in f) for f in nums("""0 3 2 1 4 5 6 7 0 1 5 4 2 3 7 6 3 0 4 7 1 2 6 5""", 4)])
mesh.update()
link(bpy.data.objects.new("one", mesh), material("one", nums("0.9 0.3 0.2", 3)[0]))

curve = bpy.data.curves.new("label 1", type="FONT")
curve.body = "1"
curve.size = 0.6
curve.align_x = "CENTER"
curve.extrude = 0.04
obj = link(bpy.data.objects.new("label 1", curve), material("label 1", nums("0.1 0.1 0.1", 3)[0]))
obj.location = nums("0.0 -1.0 1.2", 3)[0]
obj.rotation_euler = (math.pi / 2, 0.0, 0.0)

world = bpy.data.worlds.new("world")
world.use_nodes = True
world.node_tree.nodes["Background"].inputs["Color"].default_value = nums("0.6 0.7 0.9 1.0", 4)[0]
scene.world = world
sun = bpy.data.objects.new("sun", bpy.data.lights.new("sun", type="SUN"))
sun.data.energy = 3.0
sun.data.angle = 0.2
sun.rotation_euler = (math.radians(50), 0.0, math.radians(30))
scene.collection.objects.link(sun)

pivot = bpy.data.objects.new("pivot", None)
pivot.location = nums("0.0 0.0 0.5", 3)[0]
scene.collection.objects.link(pivot)
cam = bpy.data.objects.new("camera", bpy.data.cameras.new("camera"))
cam.data.lens = 35
cam.data.clip_end = 1000
cam.parent = pivot
cam.location = (0.0, -6.0, 3.0)
scene.collection.objects.link(cam)
scene.camera = cam
look = cam.constraints.new("TRACK_TO")
look.target = pivot
look.track_axis = "TRACK_NEGATIVE_Z"
look.up_axis = "UP_Y"
for o in scene.objects:
    if o.name.startswith("label "):
        face = o.constraints.new("TRACK_TO")
        face.target = cam
        face.track_axis = "TRACK_Z"
        face.up_axis = "UP_Y"
scene.frame_start = 1
scene.frame_end = 4
pivot.rotation_euler = (0.0, 0.0, 0.0)
pivot.keyframe_insert("rotation_euler", frame=1)
pivot.rotation_euler = (0.0, 0.0, 2 * math.pi)
pivot.keyframe_insert("rotation_euler", frame=5)

scene.render.engine = "BLENDER_EEVEE"
scene.view_settings.view_transform = "Standard"
scene.render.use_freestyle = True
scene.render.line_thickness = 0.8
lines = bpy.context.view_layer.freestyle_settings.linesets
lineset = lines[0] if len(lines) else lines.new("outlines")
if lineset.linestyle is None:
    lineset.linestyle = bpy.data.linestyles.new("outlines")
lineset.linestyle.color = (0.08, 0.08, 0.1)
lineset.linestyle.thickness = 1.0
scene.render.resolution_x = 64
scene.render.resolution_y = 48
scene.render.resolution_percentage = 100
scene.render.fps = 24

scene.render.image_settings.media_type = "VIDEO"
scene.render.image_settings.file_format = "FFMPEG"
scene.render.ffmpeg.format = "MPEG4"
scene.render.ffmpeg.codec = "H264"
scene.render.ffmpeg.constant_rate_factor = "HIGH"
scene.render.filepath = os.path.join(out, "orbit.mp4")
bpy.ops.render.render(animation=True)

bpy.ops.export_scene.gltf(filepath=os.path.join(out, "one.glb"), export_format="GLB")
bpy.ops.wm.obj_export(filepath=os.path.join(out, "one.obj"))
bpy.ops.wm.save_as_mainfile(filepath=os.path.join(out, "one.blend"))

with open(os.path.join(out, "report.txt"), "w") as f:
    for m in sorted(bpy.data.meshes, key=lambda m: m.name):
        f.write("mesh %s: %d vertices, %d faces\n" % (m.name, len(m.vertices), len(m.polygons)))
    for o in sorted(scene.objects, key=lambda o: o.name):
        if o.type == "EMPTY" and any(c.type == "MESH" for c in o.children):
            f.write("piece %s: %d parts, %d triangles\n" % (o.name, len(o.children_recursive), triangles(o)))
    f.write("objects: " + " ".join(sorted(o.name for o in scene.objects)) + "\n")

