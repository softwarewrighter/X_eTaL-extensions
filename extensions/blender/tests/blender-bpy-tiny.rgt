command = "t=$(mktemp -d) && XETAL_BLENDER_ROOT=$t xetal-x --ext .. run tests/bpy-tiny.xtl && cd $t && ls work/tiny/out"
exit_code = 0
desc = "two cubes and a label written as bpy, run by Blender end to end: the report (16 vertices, 12 faces; the objects) and the files made (a still, .glb, .obj, .mtl, .blend)"
