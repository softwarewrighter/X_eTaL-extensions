command = "t=$(mktemp -d) && XETAL_BLENDER_ROOT=$t xetal-x --ext .. run tests/clips.xtl && cd $t && ls work/clips/out"
exit_code = 0
desc = "a piece with two named clips (idle 2 s: head turns, body breathes; fire 0.4 s: head recoils) exported as glTF and read back: each clip by name, its span and what it moves"
