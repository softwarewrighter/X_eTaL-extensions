command = 't=$(mktemp -d) && XETAL_BLENDER_ROOT=$t XETAL_PATH="$PWD/demos:$XETAL_PATH" xetal-x --ext .. run tests/cosy-quick.xtl && cd $t && ls work/quick/out'
exit_code = 0
desc = "the CoSy logo (CosyLogo.xtl) at 160 by 90 in coarse voxels, through Blender and Cycles end to end: the five center lines fused into one mesh, CoSy, on its pivot with the camera and three lights (the parts dropped), and a still"
