command = 't=$(mktemp -d) && XETAL_BLENDER_ROOT=$t XETAL_PATH="$PWD/demos:$XETAL_PATH" xetal-x --ext .. run tests/cubes-quick.xtl && cd $t && ls work/quick/out'
exit_code = 0
desc = "the size comparison (Sizes.xtl) at 160 by 90, four frames, through Blender end to end: the report (one, a hundred, a thousand cubes: 8, 800, 8000 vertices; the ground, the labels, the camera) and the files (a still, .glb, .obj, .mtl, .blend)"
