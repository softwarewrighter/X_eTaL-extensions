command = 't=$(mktemp -d) && mkdir -p $t/work && ln -s "$PWD/../../work/fonts" $t/work/fonts && XETAL_BLENDER_ROOT=$t XETAL_PATH="$PWD/demos:$XETAL_PATH" xetal-x --ext .. run tests/explain-quick.xtl && cd $t && ls work/quick/rs work/quick/ms work/quick/mf'
exit_code = 0
desc = "the explainer videos (ReluSoftmax.xtl, Matmul.xtl, MatmulFly.xtl at 32) through Blender at 160 by 90, two stills each: each run's errors (none), Blender's report of its groups, and the stills"
