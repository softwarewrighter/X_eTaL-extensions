the manifest:
# Tower defense pieces for X_eTaL-games, made by X_eTaL driving Blender.
title = "Tower defense pieces"
program = "extensions/blender/demos/game-assets.xtl"
pieces-library = "extensions/blender/demos/Td.xtl"
repository = "https://github.com/softwarewrighter/X_eTaL-extensions"
commit = "unpublished"
license = "MIT"
blender = "Blender"
format = "glTF 2.0, binary (.glb)"
units = "meters: one tile is 1 by 1; the origin at the middle of the base, on the ground"
up = "+Y in glTF (+Z in Blender)"
front = "+Z in glTF, glTF's own front (-Y in Blender)"
clip-rate = 30
preview = "PIECE.png: 320 by 320, RGBA, transparent, the piece at rest from the front a little right and above, every preview at one scale"

[pieces.arrow-1]
kind = "tower"
glb = "arrow-1.glb"
preview = "arrow-1.png"
clips = { idle = 2.0, fire = 0.4 }

