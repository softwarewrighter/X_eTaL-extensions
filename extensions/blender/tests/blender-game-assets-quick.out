the manifest:
# Tower defense pieces for X_eTaL-games, made by X_eTaL driving Blender.
title = "Tower defense pieces"
program = "extensions/blender/demos/game-assets.xtl"
pieces-library = "extensions/blender/demos/Td.xtl"
repository = "https://github.com/softwarewrighter/X_eTaL-extensions"
commit = "unpublished"
license = "MIT"
blender = "Blender"
format = "glTF 2.0, binary (.glb)"
units = "meters: one tile is 1 by 1; the origin at the middle of the base, on the ground"
up = "+Y in glTF (+Z in Blender)"
front = "+Z in glTF, glTF's own front (-Y in Blender)"
clip-rate = 30
preview = "PIECE.png: 320 by 320, RGBA, transparent, the piece at rest from the front a little right and above, every preview at one scale"
turn-sheet = { file = "PIECE-turn.png", frame = 256, frames = 16, columns = 4, order = "row by row", turn = "22.5 degrees counterclockwise seen from above each frame, frame 0 the front", camera = "20 degrees above the horizon", scale = "each piece framed to its size" }
map-sheet = { file = "PIECE-map.png", frame = 96, frames = 8, columns = 8, facing = ["east", "southeast", "south", "southwest", "west", "northwest", "north", "northeast"], camera = "orthographic, 30 degrees above the horizon (the board's 2:1 tiles; the ask said 35)", tile = "64 by 32 pixels", pixels-per-meter = 45.25, anchor = [48, 82] }
mesh-format = { file = "PIECE-mesh.toml", pose = "at rest", vertices = "x y z per string, meters, Z up, front -Y, the origin at the middle of the base", faces = "three vertex numbers per string, from 1", colors = "#rrggbb per face, sRGB", most-triangles = 500 }

