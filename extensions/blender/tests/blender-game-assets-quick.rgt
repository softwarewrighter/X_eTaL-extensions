command = 't=$(mktemp -d) && XETAL_BLENDER_ROOT=$t XETAL_DIGEST_ROOT=$t XETAL_PATH="$PWD/demos:$XETAL_PATH" xetal-x --ext .. run tests/game-assets-quick.xtl | grep -v sha256 && cd $t && ls work/qtd/site | grep -cE "(glb|png)$" && ls work/qtd/lineup.mp4 && grep -c "<model-viewer" work/qtd/site/index.html && xetal-x run "$OLDPWD/tests/mesh-read.xtl"'
exit_code = 0
desc = "demos/game-assets.xtl small: twelve pieces, each rendered alone (32 px), a four-frame lineup video, the manifest (hash lines left out: renders differ by a bit), the page with twelve viewers, and four low-poly meshes (NAME-mesh.toml, at most 500 triangles) read back by X_eTaL (tests/mesh-read.xtl)"
