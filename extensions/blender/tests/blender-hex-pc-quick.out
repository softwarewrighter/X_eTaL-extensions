the cue sheet:
[[cue]]
n = 1
start = 0.000
end = 3.200
caption = "HEX1000: its program counter, one hop at a time"

[[cue]]
n = 2
start = 3.600
end = 9.400
caption = "slow motion: PC goes 0 1 3 7 15 31 63"

[[cue]]
n = 3
start = 9.700
end = 15.100
caption = "time-lapse: all 64 addresses, each once"

[[cue]]
n = 4
start = 15.400
end = 19.500
caption = "then back to 0: a ROM page in shift-register order"


