the wall:
pc = piece("look-wall")
top = pc
texture("look stone", "stone", nums("0.6 0.63 0.67", 3)[0], nums("0.3 0.3 0.32", 3)[0], 1.0, 256, 3)
texture("look wood", "wood", nums("0.61 0.48 0.3", 3)[0], nums("0.36 0.26 0.15", 3)[0], 0.5, 128, 2)
bpy.ops.mesh.primitive_cube_add(size=1.0)
o = made("wall block")
o.scale = nums("1.0 1.0 2.0", 3)[0]
attach(o, pc, material("wall block", nums("0.6 0.63 0.67", 3)[0], 0.0), nums("0.0 0.0 1.0", 3)[0], nums("0.0 0.0 0.0", 3)[0])
bevel("wall block", 0.03, 2)
paint("wall block", "look stone", 0)
bpy.ops.mesh.primitive_cube_add(size=1.0)
o = made("wall course")
o.scale = nums("1.06 1.06 0.1", 3)[0]
attach(o, pc, material("wall course", nums("0.6 0.63 0.67", 3)[0], 0.0), nums("0.0 0.0 1.96", 3)[0], nums("0.0 0.0 0.0", 3)[0])
bevel("wall course", 0.03, 2)
