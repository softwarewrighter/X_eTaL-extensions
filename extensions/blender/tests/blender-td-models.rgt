command = 't=$(mktemp -d) && XETAL_BLENDER_ROOT=$t XETAL_PATH="$PWD/demos:$XETAL_PATH" xetal-x --ext .. run demos/td-models.xtl && cd $t && ls work/td/out | grep -c glb'
exit_code = 0
desc = "the twelve tower defense pieces (Td.xtl) through Blender: no errors, each piece's parts and triangles (all under 3000), each .glb's clips read back (idle 2 s; fire 0.4 s; walk 1 s; hit 0.3 s), twelve .glb files"
