## The Python Bpy.xtl writes, pinned: the launcher, then the script for
## one cube, a label, lights, an orbit, a video and the exports.

"bp:" u_se< "Bpy"
"the launcher:"
bp:launcher
"the scene:"
bp:head c_at (("one", 1 3 r_eshape 0.0 0.0 0.5, 0.9, 0.9 0.3 0.2) bp:c_ubes 0) c_at (("1", 0.0 -1.0 1.2, 0.6, 0.1 0.1 0.1) bp:l_abel 0) c_at ((0.6 0.7 0.9, 3.0) bp:l_ights 0) c_at ((0.0 0.0 0.5, 6.0, 3.0, 4) bp:o_rbit 0) c_at ((64, 48, 24) bp:s_etup 0) c_at (bp:v_ideo "orbit.mp4") c_at (bp:e_xports "one") c_at bp:report
