## The city, small and quick: the same scene (NeonCity.xtl) at 64 by 36
## and 4 samples on the processor, a still from the street; Blender's
## report and the files.

"bl:" u_se< "Blender"
"bp:" u_se< "Bpy"
"cy:" u_se< "Cycles"
"nc:" u_se< "NeonCity"

"the lots, and the boxes of the towers in each skin:"
s_hape nc:lots
(1 s_elect s_hape nc:t_owers 0) c_at (1 s_elect s_hape nc:t_owers 1) c_at 1 s_elect s_hape nc:t_owers 2
script := ((64, 36, 30, 4, "CPU") nc:s_cene 0) c_at ("street.png", 10.5) cy:s_till 0
n := "work/cityquick/run.py" bl:w_rite! bp:launcher
n := "work/cityquick/scene.py" bl:w_rite! script
r := "work/cityquick/run.py" bl:r_un! "work/cityquick/scene.py work/cityquick/out"
"the run, and the error lines in Blender's log:"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
"what Blender made:"
bl:r_ead "work/cityquick/out/report.txt"
