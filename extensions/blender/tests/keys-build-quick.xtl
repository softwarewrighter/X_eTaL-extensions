## Actual build artifacts through the scene generator and Blender:
## two shapes, the unplaced, placed, routed and board stages.
"bl:" u_se< "Blender"
"bp:" u_se< "Bpy"
"vd:" u_se< "Video"
"kb:" u_se< "KeysBuild"

rawcells := n_umbers bl:r_ead "work/keysbuild/cells.txt"
rawroutes := n_umbers bl:r_ead "work/keysbuild/routes.txt"
cells := (((t_ally rawcells) d_iv 4) c_at 4) r_eshape rawcells
routes := (((t_ally rawroutes) d_iv 2) c_at 2) r_eshape rawroutes
stats := f_loor n_umbers bl:r_ead "work/keysbuild/stats.txt"
n := "work/keysbuild/run.py" bl:w_rite! bp:launcher
n := "work/keysbuild/quick.py" bl:w_rite! ((640 360, cells, routes, stats) kb:s_cene 0) c_at ((5.0 10.0 16.8 19.0 23.0 31.0, "wide") vd:s_tills 0) c_at vd:report
r := "work/keysbuild/run.py" bl:r_un! "work/keysbuild/quick.py work/keysbuild/quick"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
bl:r_ead "work/keysbuild/quick/report.txt"
n := "work/keysbuild/quick-short.py" bl:w_rite! ((360 640, cells, routes, stats) kb:s_cene 0) c_at ((5.0 10.0 16.8 19.0 23.0 31.0, "short") vd:s_tills 0) c_at vd:report
r := "work/keysbuild/run.py" bl:r_un! "work/keysbuild/quick-short.py work/keysbuild/quick-short"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
bl:r_ead "work/keysbuild/quick-short/report.txt"
