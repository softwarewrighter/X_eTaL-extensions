## Six key stages of the actual checked Nano 1K execution, both shapes.
"bl:" u_se< "Blender"
"bp:" u_se< "Bpy"
"vd:" u_se< "Video"
"kr:" u_se< "KeysRun"
raw := f_loor n_umbers []N_GET "work/keysrun/samples.txt"
samples := (((t_ally raw) d_iv 26) c_at 26) r_eshape raw
word := f_irst f_loor n_umbers []N_GET "work/keysrun/spi-word.txt"
n := "work/keysrun/run.py" bl:w_rite! bp:launcher
n := "work/keysrun/quick.py" bl:w_rite! ((640 360, samples, word) kr:s_cene 0) c_at ((4.5 7.0 14.8 25.8 28.0 35.0, "wide") vd:s_tills 0) c_at vd:report
r := "work/keysrun/run.py" bl:r_un! "work/keysrun/quick.py work/keysrun/quick"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
bl:r_ead "work/keysrun/quick/report.txt"
n := "work/keysrun/quick-short.py" bl:w_rite! ((360 640, samples, word) kr:s_cene 0) c_at ((4.5 7.0 14.8 25.8 28.0 35.0, "short") vd:s_tills 0) c_at vd:report
r := "work/keysrun/run.py" bl:r_un! "work/keysrun/quick-short.py work/keysrun/quick-short"
lines := (n_ot r = f_irst "\n") p_artition r
d_isclose 1 s_elect lines
d_isclose 2 s_elect lines
bl:r_ead "work/keysrun/quick-short/report.txt"
