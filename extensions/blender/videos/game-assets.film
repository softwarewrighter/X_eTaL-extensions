# extensions/blender/videos/game-assets.webm and .webp: what Blender
# made for the tower defense game, from demos/game-assets.xtl (just
# videos; about five minutes when the videos are not there yet): the
# twelve preview pictures side by side, then the twelve pieces lined up
# in 3D, turning, playing idle, then fire and walk.
demo=game-assets
file=work/td/lineup.mp4
sheet=work/td/site/*.png
hold=4
scale=800
fps=15
