# extensions/blender/videos/hex-run.webm and .webp: HEX1000 computing
# C0DE+BEEF= from a simulation of its board -- the serial line's bits,
# the key matrix, the program counter, A, the status, the ALU, the RAM,
# the display -- every lamp keyed from the waveform, the browser
# calculator's screen beside the display at the end. Blender's own
# render (EEVEE), made by demos/hex-run.xtl (HexRun.xtl; just ext
# blender hex-run; about 25 minutes when the video is not there yet).
# The demo's Short (1080 by 1920) and cue sheet stay in work/.
demo=hex-run
file=work/hexrun/out/hex-run.mp4
scale=1280
fps=30
