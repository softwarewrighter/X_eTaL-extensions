# canvas -- a native window showing X_eTaL arrays as pixels, with keys and clicks back. `just` lists recipes.
# Run from this directory (or `just ext canvas RECIPE` from the repo root).

set positional-arguments

root := "../.."

# List the recipes
default:
    @just --list

# Build the native library (target/debug/libxetal_ext_canvas.dylib or .so) and xetal-x
build:
    cd {{root}} && cargo build -q --workspace

# Rust tests  and the reg-rs tests
test: test-rust reg

# Rust tests of the crate in rust/
test-rust:
    cargo test -q -p xetal-ext-canvas

# reg-rs tests in tests/ (baselines committed there)
reg:
    {{root}}/scripts/reg-ext.sh canvas run

# Show the reg-rs failures in full
reg-diff:
    {{root}}/scripts/reg-ext.sh canvas run -vv

# Accept the latest output of one reg-rs test as its baseline (review the diff)
rebase test:
    {{root}}/scripts/reg-ext.sh canvas rebase -p "$1"

# The functions this extension exports, as xetal-x sees them
list: build
    {{root}}/target/debug/xetal-x --ext . --ext-list

# Open a window briefly (needs a desktop session; not part of the gate)
smoke: build
    {{root}}/target/debug/xetal-x --ext . run tests/smoke.xtl

# Run a demo: just demo NAME (demos/NAME.xtl; pictures go to work/draw/)
demo name: build
    {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw "demos/$1.xtl"
