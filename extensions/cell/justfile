# cell -- a robot assembly cell, simulated: arms, tools and parts that build circuits in free air. `just` lists recipes.
# Run from this directory (or `just ext cell RECIPE` from the repo root).

set positional-arguments

root := "../.."

# List the recipes
default:
    @just --list

# Build the native library (target/debug/libxetal_ext_cell.dylib or .so) and xetal-x
build:
    cd {{root}} && cargo build -q --workspace

# Rust tests  and the reg-rs tests
test: test-rust reg

# Rust tests of the crate in rust/
test-rust:
    cargo test -q -p xetal-ext-cell

# reg-rs tests in tests/ (baselines committed there)
reg:
    {{root}}/scripts/reg-ext.sh cell run

# Show the reg-rs failures in full
reg-diff:
    {{root}}/scripts/reg-ext.sh cell run -vv

# Accept the latest output of one reg-rs test as its baseline (review the diff)
rebase test:
    {{root}}/scripts/reg-ext.sh cell rebase -p "$1"

# The functions this extension exports, as xetal-x sees them
list: build
    {{root}}/target/debug/xetal-x --ext . --ext-list

# Run a demo: just demo NAME (demos/NAME.xtl; pictures go to work/draw/)
demo name: build
    {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw "demos/$1.xtl"

# Build the crate for the browser (wasm32): the simulator has no threads, files or clocks
wasm:
    cd {{root}} && cargo check -q -p xetal-ext-cell --lib --target wasm32-unknown-unknown

# The command table as markdown, for docs/README.md
command-table:
    cd {{root}} && cargo run -q -p xetal-ext-cell --example command-table

# Build every model through Blender: work/cell/models (NAME.glb, NAME.rig.json, check.txt, stills/)
models: build
    {{root}}/target/debug/xetal-x --ext {{root}}/extensions run demos/models.xtl

# Copy the rigs the simulator reads (the arm, the tools, the fixtures) from work/cell/models into rigs/
rigs:
    for n in arm tweezers iron solder clip welder cutter wire rack tray stage scope; do cp "work/cell/models/$n.rig.json" rigs/; done

# The turntable stills as one contact sheet for the extension's page: docs/models.jpg
sheet:
    ffmpeg -loglevel error -y -pattern_type glob -i 'work/cell/models/stills/*.png' -vf "scale=160:120,tile=8x11" -frames:v 1 -q:v 4 docs/models.jpg
