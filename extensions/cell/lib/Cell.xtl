## Cell.xtl -- the facade of the cell extension: a robot assembly cell,
## simulated -- four arms, a tool rack, trays of parts and a microscope
## that build circuits in free air, one command at a time
## (docs/cell-design.md).
## Import: "ce:" u_se< "Cell"
## Run with xetal-x (xetal-x --ext DIR puts this directory on XETAL_PATH).
## Each signature line is written out by the binding macro (lib/Ffi.xtlm,
## docs/ffi-macro.md).

"ffi:" u_se< "Ffi"

## ce:a_bout @: the extension's name and version, "cell 0.1.0".
"a_bout : unit -> text"         ffi:b_ind< "cell/about"
## ce:p_arts @: the parts library, one line a kind -- its name, how many
## pins, a title, an example part, and "heat sensitive" for the kinds
## that need a heatsink clip between body and joint:
## "dip8 8 pins: DIP-8 (NE555 timer)".
"p_arts : unit -> text"         ffi:b_ind< "cell/parts"
## ce:p_art kind: one part kind as JSON -- its body, its pins worked out
## (each a name, a lead as a polyline from the body, its diameter and
## material), its grasp frames and its thermal data; ce:p_art "dip8".
"p_art : text -> text"          ffi:b_ind< "cell/part"
## ce:t_ips kind: a kind's pin tips in its own frame (its body's center
## at the origin), mm: x y z a line, in pin order -- read with n_umbers
## (the planner, CellPlan.xtl, places parts from them); for an axial
## resistor "-31 0 0\n31 0 0".
"t_ips : text -> text"          ffi:b_ind< "cell/tips"
## ce:c_ommands @: the command language, one line a command -- its
## synopsis (positional arguments in capitals, optional ones in
## brackets) and what it does: "lift ARM [mm=MM] -- move the tool
## straight up".
"c_ommands : unit -> text"      ffi:b_ind< "cell/commands"
## ce:p_arse program: a program checked against the command table, each
## command as JSON, one a line, its arguments in the table's order. The
## program is text -- one command a line, ";" between commands on a
## line, "#" a comment -- or a line holding one JSON command. A wrong
## command is an error naming its line and what is wrong.
"p_arse : text -> text"         ffi:b_ind< "cell/parse"
## ce:r_un program: the program run on a new cell -- arms home, the
## stage at 0, the vise open, the time 0 -- each command's outcome as
## JSON, one a line: ok, the command, its start and end times, what it
## did, why it was refused or where it stopped, events and warnings. It
## stops after the first command that is not ok.
"r_un : text -> text"           ffi:b_ind< "cell/run"
## ce:s_tate program: the program run on a new cell, the cell's state
## after it as JSON -- the time, the arms (base, joints, tool, track:
## rows of the time and j1 to j6), the stage and its track, the vise,
## the parts and the timeline. A command not ok is an error naming it.
"s_tate : text -> text"         ffi:b_ind< "cell/state"
## name ce:s_cene program: the program run on a new cell, written as a
## scene for the players -- one call a line, its first cell(name, 1280,
## 720), then the fixtures, each arm (rig) with its track (rows of the
## time and the six joint angles), the stage's track, the parts, a
## step a command with its times, and expect lines (an arm's flange at
## a time, for a check of the drawing). The three extension's cell
## player draws it (th:p_age! writes a page). A command not ok is an
## error naming it.
"s_cene : text text -> text"    ffi:b_ind< "cell/scene"
## ce:r_ig @: the arm's rig as JSON -- each joint's DH parameters
## (alpha, a, d, offset), its limits, top speed and acceleration, and
## the home pose; every arm in the cell is this arm.
"r_ig : unit -> text"           ffi:b_ind< "cell/rig"
## ce:a_rmModel @: what a model of the arm must be, as JSON (the asset
## contract, docs/cell-design.md): its nodes -- arm_base, arm_j1 to
## arm_j6, arm_flange -- each placed in its parent (mm, and Euler XYZ
## degrees) with where it is at rest and its local z, the joint's axis;
## the links between the pivots; check poses (joint angles with where
## the flange must then be); and the rig. CellModels.xtl builds the arm
## from it, and Blender writes it back as arm.rig.json.
"a_rmModel : unit -> text"      ffi:b_ind< "cell/arm_model"

## The native package behind these functions (a literal l: name also
## makes this file a library to `xetal type`: ask E7).
l:package := "cell"
