# arms: the bench without parts -- arm A reaches into the work zone,
# the turntable closes its vise, turns and rises under it, A lifts
# away, the turntable turns back down, and A goes home.
move A to=0,90,40 rpy=180,0,0
vise close
stage turn=180
stage at=0,0,30
lift A mm=60
stage turn=-90 at=0,0,0
vise open
joints A 0 0 0 0 90 0
