// Calls added to the arms preview's scene for the player, until the
// simulator places parts itself: a DIP-8 at arm A's flange, carried by
// A through its lift and left there, and a ghost LED beside the stage.
part('U1', 'dip8', nums('0 30 40 0 0 0', 6)[0])
attach('U1', 'A', 15.177256, 18.127256)
ghost('U2', 'led-5mm', nums('0 -30 20 0 0 0', 6)[0])
expect('U1', 1, nums('0 30 40', 3)[0])
expect('U1', 16, nums('0 30 40', 3)[0])
expect('U1', 17.777256, nums('0 30 70', 3)[0])
expect('U1', 22.433324, nums('0 30 100', 3)[0])
expect('U1', 26, nums('0 30 100', 3)[0])
