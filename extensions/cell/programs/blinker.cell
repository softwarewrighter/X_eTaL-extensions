# The 555 blinker, in progress: 5 of its 7 nets made (VCC but the
# battery, DIS, THR, CTRL, OUT, LED); GND and the battery snap are
# not joined yet, and check ends by saying so.
reset circuit=blinker
tool A tweezers
pick A U1 grasp=ends
place A U1 at=0,0,-24 rpy=0,0,90
vise close
release A U1
wire S5 awg=30 span=U1.4.tip+U1.8.tip enamel=yes
pick A W1 grasp=middle
cut S5
lift A mm=60
bring A W1.1 to=U1.4.tip end=U1.8.tip from=1,0,-0.15
pinch P1 on=W1.1 at=1.5
release A W1
lift A mm=60
present U1.4+W1.1 at=S1
touch S1 at=U1.4+W1.1 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=U1.4+W1.1 below=100
inspect U1.4+W1.1
present U1.8+W1.2 at=S1
touch S1 at=U1.8+W1.2 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=U1.8+W1.2 below=100
inspect U1.8+W1.2
unpinch P1
park P1
stage to=0 tilt=0 at=0,0,0
wire S5 awg=30 span=U1.2.4+U1.6.4 enamel=yes
pick A W2 grasp=middle
cut S5
lift A mm=60
bring A W2.1 to=U1.2.4 end=U1.6.4 from=1,0,-0.15
pinch P1 on=W2.1 at=1.5
release A W2
lift A mm=60
present U1.2+W2.1 at=S1
touch S1 at=U1.2+W2.1 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=U1.2+W2.1 below=100
inspect U1.2+W2.1
present U1.6+W2.2 at=S1
touch S1 at=U1.6+W2.2 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=U1.6+W2.2 below=100
inspect U1.6+W2.2
unpinch P1
park P1
stage to=0 tilt=0 at=0,0,0
pick A R1 grasp=body
lift A mm=60
bring A R1.1 to=U1.8.tip along=-0.658,-0.753,0
pinch P2 on=R1.1 at=3
release A R1
lift A mm=60
present U1.8+R1.1 at=S1
touch S1 at=U1.8+R1.1 dwell=2
feed S1 mm=2 rate=1
back S1
wait until=U1.8+R1.1 below=100
inspect U1.8+R1.1
unpinch P2
park P2
stage to=0 tilt=0 at=0,0,0
pick A R2 grasp=body
lift A mm=60
bring A R2.2 to=U1.6.tip along=-0.934,0.356,0
pinch P2 on=R2.2 at=3
release A R2
lift A mm=60
present U1.6+R2.2 at=S1
touch S1 at=U1.6+R2.2 dwell=2
feed S1 mm=2 rate=1
back S1
wait until=U1.6+R2.2 below=100
inspect U1.6+R2.2
unpinch P2
park P2
stage to=0 tilt=0 at=0,0,0
pick A R3 grasp=body
lift A mm=60
bring A R3.1 to=U1.3.tip along=0.934,0.356,0
pinch P1 on=R3.1 at=3
release A R3
lift A mm=60
present U1.3+R3.1 at=S1
touch S1 at=U1.3+R3.1 dwell=2
feed S1 mm=2 rate=1
back S1
wait until=U1.3+R3.1 below=100
inspect U1.3+R3.1
unpinch P1
park P1
stage to=0 tilt=0 at=0,0,0
pick A C1 grasp=body
lift A mm=60
bring A C1.1 to=U1.2.tip along=0.654,-0.249,0.7
pinch P1 on=C1.1 at=6
release A C1
lift A mm=60
present U1.2+C1.1 at=S1
touch S1 at=U1.2+C1.1 dwell=2
feed S1 mm=2 rate=1
back S1
wait until=U1.2+C1.1 below=100
inspect U1.2+C1.1
unpinch P1
park P1
stage to=0 tilt=0 at=0,0,0
pick A C2 grasp=body
lift A mm=60
bring A C2.1 to=U1.5.tip along=-0.461,0.527,0.7
pinch P2 on=C2.1 at=3
release A C2
lift A mm=60
present U1.5+C2.1 at=S1
touch S1 at=U1.5+C2.1 dwell=2
feed S1 mm=2 rate=1
back S1
wait until=U1.5+C2.1 below=100
inspect U1.5+C2.1
unpinch P2
park P2
stage to=0 tilt=0 at=0,0,0
pick A D1 grasp=body
lift A mm=60
bring A D1.1 to=R3.2.tip along=0.654,0.249,0.7
pinch P1 on=D1.1 at=6
release A D1
lift A mm=60
present R3.2+D1.1 at=S1
touch S1 at=R3.2+D1.1 dwell=2
feed S1 mm=2 rate=1
back S1
wait until=R3.2+D1.1 below=100
inspect R3.2+D1.1
unpinch P1
park P1
stage to=0 tilt=0 at=0,0,0
wire S5 awg=30 span=R1.2.tip+U1.7.tip enamel=yes
pick A W3 grasp=middle
cut S5
lift A mm=60
bring A W3.1 to=R1.2.tip end=U1.7.tip from=-1,0,-0.15
pinch P2 on=W3.1 at=1.5
release A W3
lift A mm=60
present R1.2+W3.1 at=S1
touch S1 at=R1.2+W3.1 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=R1.2+W3.1 below=100
inspect R1.2+W3.1
present U1.7+W3.2 at=S1
touch S1 at=U1.7+W3.2 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=U1.7+W3.2 below=100
inspect U1.7+W3.2
unpinch P2
park P2
stage to=0 tilt=0 at=0,0,0
wire S5 awg=30 span=R2.1.tip+U1.7.tip enamel=yes
pick A W4 grasp=middle
cut S5
lift A mm=60
bring A W4.1 to=R2.1.tip end=U1.7.tip from=-1,0,-0.15
pinch P2 on=W4.1 at=1.5
release A W4
lift A mm=60
present R2.1+W4.1 at=S1
touch S1 at=R2.1+W4.1 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=R2.1+W4.1 below=100
inspect R2.1+W4.1
present U1.7+W4.2 at=S1
touch S1 at=U1.7+W4.2 dwell=3 temp=400
feed S1 mm=1.5 rate=1
back S1
wait until=U1.7+W4.2 below=100
inspect U1.7+W4.2
unpinch P2
park P2
stage to=0 tilt=0 at=0,0,0
inspect shorts
check
