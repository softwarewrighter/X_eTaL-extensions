# The two-transistor astable multivibrator, in progress (decision C24):
# the ground-plane tile (T1) in the vise, its posts up; VCC across the far
# end; the four resistors, the two transistors, the two capacitors and
# the LEDs' anodes, every joint a lap. Not yet joined: the LEDs' cathodes
# and the battery snap. Written by tools/multivibrator-trial.py (stage 5).
reset circuit=multivibrator
tool A tweezers
pick A T1 grasp=body
place A T1 at=0,0,-24 rpy=0,0,90
vise close
release A T1
lift A mm=60
wire S5 awg=30 span=T1.5.tip+T1.10.tip lap=3.2 via=0,15.24,-16.5 enamel=yes
pick A W1 grasp=middle
cut S5
lift A mm=60
lay A W1
pinch P1 on=W1.1 at=1.5
release A W1
lift A mm=60
move A to=0,60,60
joints A 0 0 0 0 90 0
present T1.5+W1.1 at=S1
touch S1 at=T1.5+W1.1 dwell=1.5 temp=400
feed S1 mm=2 rate=1
back S1
wait until=T1.5+W1.1 below=100
inspect T1.5+W1.1
present T1.10+W1.2 at=S1
touch S1 at=T1.10+W1.2 dwell=1.5 temp=400
feed S1 mm=2 rate=1
back S1
wait until=T1.10+W1.2 below=100
inspect T1.10+W1.2
unpinch P1
park P1
stage to=0 tilt=0 at=0,0,0
pick A R1 grasp=body
lift A mm=60
insert A on=R1.2 at=12
form angle=90
lift A mm=30
shear A on=R1.2 at=17.2
lift A mm=60
bring A R1.2 to=T1.2.tip along=-0.95,-0.3,0 lap=3.2
pinch P2 on=R1.2 at=3
release A R1
lift A mm=60
move A to=0,60,60
joints A 0 0 0 0 90 0
present T1.2+R1.2 at=S1
touch S1 at=T1.2+R1.2 dwell=1.5 temp=400
feed S1 mm=2 rate=1
back S1
wait until=T1.2+R1.2 below=100
inspect T1.2+R1.2
present R1.1.10 at=S4
trim S4 on=R1.1 at=10
back S4
unpinch P2
park P2
stage tilt=0 at=0,0,0
stage to=0
pick A R2 grasp=body
lift A mm=60
insert A on=R2.2 at=12
form angle=90
lift A mm=30
shear A on=R2.2 at=17.2
lift A mm=60
bring A R2.2 to=T1.4.tip along=-0.95,0.3,0 lap=3.2
pinch P2 on=R2.2 at=3
release A R2
lift A mm=60
move A to=0,60,60
joints A 0 0 0 0 90 0
present T1.4+R2.2 at=S1
touch S1 at=T1.4+R2.2 dwell=1.5 temp=400
feed S1 mm=2 rate=1
back S1
wait until=T1.4+R2.2 below=100
inspect T1.4+R2.2
present R2.1.10 at=S4
trim S4 on=R2.1 at=10
back S4
unpinch P2
park P2
stage tilt=0 at=0,0,0
stage to=0
pick A R4 grasp=body
lift A mm=60
insert A on=R4.2 at=12
form angle=90
lift A mm=30
shear A on=R4.2 at=17.2
