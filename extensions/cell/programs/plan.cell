feed S1 mm=2 rate=1
back S1
wait until=U1.7+R4.1 below=100
inspect U1.7+R4.1
unpinch P1
stage to=0 tilt=0 at=0,0,0
pick A R1 grasp=body
lift A mm=60
insert A on=R1.1 at=12
form angle=90
lift A mm=30
shear A on=R1.1 at=17.2
lift A mm=60
bring A R1.1 to=U1.2.tip along=-0.934,-0.356,0.0 lap=3.2
pinch P2 on=R1.1 at=3
release A R1
lift A mm=60
move A to=0,60,60 rpy=180,0,90
joints A 0 0 0 0 90 0
present U1.2+R1.1 at=S1
