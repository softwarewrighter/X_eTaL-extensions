command = "xetal-x --ext .. run demos/solder.xtl"
exit_code = 0
desc = "programs/solder.cell through ce:r_un: a DIP in the vise, a resistor lead held to pin 3, the iron on the joint, solder fed and melted, the joint frozen good, the resistor staying when let go, the pair lifted out of the vise together"
