cell 0.1.0
  cell/about : Unit -> Char    # The extension's name and version.
  cell/parts : Unit -> Char    # The parts library, one line a kind: kind, pins, title, example.
  cell/part : Char -> Char    # One part kind, its pins worked out, as JSON.
  cell/tips : Char -> Char    # A kind's pin tips in its own frame: x y z a line, in pin order.
  cell/commands : Unit -> Char    # The command list, one line a command: its synopsis and what it does.
  cell/parse : Char -> Char    # A program (text, or JSON lines) checked against the command table: each command as JSON, one a line.
  cell/run : Char -> Char    # A program run on a new cell: each command's outcome as JSON, one a line, stopping after the first not ok.
  cell/state : Char -> Char    # A program run on a new cell: its state after, as JSON; a command not ok is an error.
  cell/arm_model : Unit -> Char    # What a model of the arm must be, as JSON: nodes (one a joint's pivot, local z its axis), links, check poses, the rig.
  cell/scene : Char -> Char -> Char    # name program: the program run on a new cell, written as a scene for the players (cell(...), rig, track, step, ...).
  cell/rig : Unit -> Char    # The arm's rig as JSON: its joints' DH parameters, limits, speeds and home.
  cell/begin : Char -> Char    # A new session cell for a circuit (the planner's): the reset's outcome.
  cell/attempt : Char -> Char    # Commands tried on the session's cell: kept if all are ok (ok, then the outcomes), else the cell as it was and: no COMMAND: why.
  cell/frame : Char -> Char    # Where a frame of the session's cell is now: x y z, mm.
  cell/kind : Char -> Char    # A part of the session's cell: its kind, then kitted if its leads came cut.
  cell/next_wire : Unit -> Char    # The id the session's next wire will have.
  cell/joined : Char -> Char    # The pins a pin of the session's cell is soldered to, space between.
