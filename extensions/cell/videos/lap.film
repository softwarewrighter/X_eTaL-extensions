# extensions/cell/videos/lap.webm and .webp: the live page running
# programs/lap.cell, as the page itself draws it -- one headless
# Chrome (no window) seeking each moment of the program, joined (just
# ext cell live, then just ext cell record lap:
# work/record/lap.mp4; then just videos cell lap). The video at
# the page's full width; the README's animated picture smaller.
demo=lap
file=work/record/lap.mp4
scale=1280
webp=480
fps=12
