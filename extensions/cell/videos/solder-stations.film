# extensions/cell/videos/solder-stations.webm and .webp: the live page running
# programs/solder-stations.cell, as the page itself draws it -- one headless
# Chrome (no window) seeking each moment of the program, joined (just
# ext cell live, then just ext cell record solder-stations:
# work/record/solder-stations.mp4; then just videos cell solder-stations). The video at
# the page's full width; the README's animated picture smaller.
demo=solder-stations
file=work/record/solder-stations.mp4
scale=1280
webp=480
fps=12
