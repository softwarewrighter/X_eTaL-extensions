# What the text bridge costs (docs/bridge.md): calls per second, and
# Floats per second carried out and back. Run with every extension:
#   xetal-x --ext extensions run extensions/clock/demos/bridge-cost.xtl
"ck:" u_se< "Clock"
"hx:" u_se< "Hello"

# 200 calls of hello's answer: each is a get across the channel
n := 200
ms := '{ k -> '{ i -> hx:a_nswer @ } e_ach r_ange k } ck:t_ime n
"calls per second:"
f_loor (1000.0 * f_loat n) / ms m_ax 0.001

# a 100,000-element Float array out to Rust and back (echo)
v := 0.5 + f_loat r_ange 100000
ms := 'hx:e_cho ck:t_ime v
"Floats per second, out and back:"
f_loor (1000.0 * 100000.0) / ms m_ax 0.001

# the same sum in X_eTaL and in Rust
"sum in X_eTaL (ms), in Rust over the bridge (ms):"
('{ x -> '+ r_/ x } ck:t_ime v) m_ax 0.0
('hx:s_um ck:t_ime v) m_ax 0.0
