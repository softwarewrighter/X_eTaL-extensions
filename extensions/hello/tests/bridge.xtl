# Every hello function called through the raw ext: channel of xetal-x
# (docs/bridge.md); the facade lib/Hello.xtl hides this channel.

# arity 0: the call alone; the reply is text, read back as a number
f_loor n_umbers []N_GET "ext:hello/answer"
[]N_GET "ext:hello/answer?kind"

# text in and out
n := "café x_etal" []N_PUT "ext:hello/shout?text"
[]N_GET "ext:hello/shout"

# two Int scalars (left, then right): an Int reply
a := "40" []N_PUT "ext:hello/add?int"
b := "2" []N_PUT "ext:hello/add?int"
[]N_GET "ext:hello/add"
[]N_GET "ext:hello/add?kind"

# a matrix: its ravel as text, its shape in the path
m := 2 3 r_eshape 0.5 1.0 1.5 2.0 2.5 3.0
p := (f_ormat r_avel m) []N_PUT "ext:hello/sum?float=" c_at f_ormat s_hape m
f_irst n_umbers []N_GET "ext:hello/sum"

# echo: the matrix back, reshaped by the reply's shape
q := (f_ormat r_avel m) []N_PUT "ext:hello/echo?float=" c_at f_ormat s_hape m
e := n_umbers []N_GET "ext:hello/echo"
(f_loor n_umbers []N_GET "ext:hello/echo?shape") r_eshape e

# kinds: how the elements arrived (Bool, Int, Float, Char counts)
k := (f_ormat r_avel 1 0 1 = 1) []N_PUT "ext:hello/kinds?bool=3"
[]N_GET "ext:hello/kinds"
k := "ab\ncd" []N_PUT "ext:hello/kinds?chars=2 2"
[]N_GET "ext:hello/kinds"
