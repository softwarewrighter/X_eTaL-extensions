# Voxels.xtl -- voxel chunks as arrays, shared by the voxels-* demos
# (docs/voxels.md). A chunk is a 16 by 16 by 16 array of block numbers,
# indexed x (east), y (up), z (south); 0 is air.
# Import: "vx:" u_se< "Voxels"
# (Not voxels.xtl: on a case-insensitive file system a demo of that name
# would be this file -- ask E8.)

# the side of a chunk, and its cells
l:n := 16
l:cells := 4096

# block numbers, and a character for each when printed
l:air := 0
l:stone := 1
l:dirt := 2
l:grass := 3
l:sand := 4
l:water := 5
l:wood := 6
l:leaves := 7
l:names := "air stone dirt grass sand water wood leaves"
l:glyphs := " #%\":~|*"

# every cell's x, y and z, as vectors in the chunk's order (x slowest)
i := (r_ange 4096) - 1
l:xs := i d_iv 256
l:ys := (i d_iv 16) m_od 16
l:zs := i m_od 16

# vx:h_ills phase: a 16 by 16 height field (x by z), rolling hills of
# heights 3 to 12; the phase shifts them
l:h_ills := { p ->
  x := f_loat (r_ange 16) - 1
  a := 2.5 * s_in p + x / 2.5
  b := 2.0 * c_os p + x / 3.0
  f_loor 7.5 + a '+ t_able b
}

# vx:c_hunk h: the chunk on a height field h (x by z): grass on top,
# three of dirt, stone below; water fills air below 7, and sand
# replaces grass at or below it; one tree on the hill at (4, 4) when it
# stands above the water
l:c_hunk := { h ->
  top := (1 + l:zs + 16 * l:xs) s_elect r_avel h
  d := top - l:ys
  b := (d = 1) * 3
  b := b + (d > 1) * (d < 5) * 2
  b := b + (d >= 5) * 1
  b := b + (b = 3) * (l:ys <= 7) * 1
  b := b + (b = 0) * (l:ys < 7) * 5
  # the tree: a trunk of 3 at (4, 4), leaves around its top
  t := (1 + 4 + 16 * 4) s_elect r_avel h
  up := t > 7
  ax := a_bs l:xs - 4
  az := a_bs l:zs - 4
  trunk := up * (ax = 0) * (az = 0) * (l:ys >= t) * l:ys < t + 3
  crown := up * (ax <= 1) * (az <= 1) * (l:ys >= t + 2) * (l:ys <= t + 3) * 1 - trunk
  b := b + trunk * 6 - b
  b := b + crown * (b = 0) * 7
  16 16 16 r_eshape b
}

# vx:c_ounts b: how many of each block, air first
l:c_ounts := { b -> '+ r_/_2 ((r_ange 8) - 1) '= t_able r_avel b }

# x vx:s_ide b: the slice at x, as characters, up at the top
l:s_ide := { x b -> r_ev (1 + (x + 1) s_elect b) s_elect l:glyphs }

# a column value (x by z) at every cell of its column
l:c_olumn := { m -> 16 16 16 r_eshape (1 + l:zs + 16 * l:xs) s_elect r_avel m }

# vx:t_op b: what is seen from above: the highest non-air block of each
# column (x by z) -- the top's height by a max-reduction down each
# column, then the block there picked by comparing heights
l:t_op := { b ->
  y1 := 16 16 16 r_eshape l:ys + 1
  hi := 'm_ax r_/_2 y1 * b > 0
  '+ r_/_2 b * y1 = l:c_olumn hi
}

# -- faces --------------------------------------------------------------
# the cells' coordinates as 16 by 16 by 16 arrays
X := 16 16 16 r_eshape l:xs
Y := 16 16 16 r_eshape l:ys
Z := 16 16 16 r_eshape l:zs

# a solid block is any but air and water
l:s_olid := { b -> (b > 0) * b != 5 }

# the exposed faces in the six directions -- west, east, down, up,
# north, south: numbered 0 to 5 -- as a 6 by 4096 Boolean array: a
# solid cell whose neighbor that way is not solid. The neighbor is a
# rotation along the axis (the six rotations of the Life idiom) with
# the plane that wrapped around made air: beyond the border is air.
l:e_xposed := { b ->
  s := l:s_olid b
  w := s > (-1 o_-_1 s) * X > 0
  e := s > (1 o_-_1 s) * X < 15
  d := s > (-1 o_-_2 s) * Y > 0
  u := s > (1 o_-_2 s) * Y < 15
  n := s > (-1 o_-_3 s) * Z > 0
  so := s > (1 o_-_3 s) * Z < 15
  6 4096 r_eshape (r_avel w) c_at (r_avel e) c_at (r_avel d) c_at (r_avel u) c_at (r_avel n) c_at r_avel so
}

# water's surface: water with air above it, facing up
l:s_urface := { b -> (b = 5) > (1 o_-_2 b > 0) * Y < 15 }

# d r_ows mb: the faces of one direction as 5 rows -- x, y, z of the
# cell, the direction, the block -- from mb, the mask times 1 + the
# block (so one array carries both)
r_ows := { d mb ->
  k := w_here mb > 0
  (5 c_at t_ally k) r_eshape (k s_elect l:xs) c_at (k s_elect l:ys) c_at (k s_elect l:zs) c_at ((t_ally k) r_eshape d) c_at (k s_elect mb) - 1
}

# vx:f_aces b: every face to draw, one row each -- x y z direction
# block -- the six directions' exposed faces, then water's surface
l:f_aces := { b ->
  m := l:e_xposed b
  bb := 1 + r_avel b
  r := (0 r_ows bb * 1 s_elect m) c_at_2 (1 r_ows bb * 2 s_elect m) c_at_2 (2 r_ows bb * 3 s_elect m)
  r := r c_at_2 (3 r_ows bb * 4 s_elect m) c_at_2 (4 r_ows bb * 5 s_elect m) c_at_2 (5 r_ows bb * 6 s_elect m)
  2 1 t_ranspose r c_at_2 3 r_ows bb * r_avel l:s_urface b
}

# vx:c_ount f: how many faces in each direction (west east down up
# north south)
l:c_ount := { f -> '+ r_/_2 (r_ange 6) '= t_able 1 + 4 s_elect_2 f }

# -- drawing ------------------------------------------------------------
# the corners of each direction's face, from its cell's corner, taken
# in pairs round the square (1 2, 2 3, 3 4, 4 1): x, y, z, 6 by 8 each
ox := 6 8 r_eshape (8 r_eshape 0) c_at (8 r_eshape 1) c_at (0 1 1 1 1 0 0 0) c_at (0 1 1 1 1 0 0 0) c_at (0 1 1 1 1 0 0 0) c_at 0 1 1 1 1 0 0 0
oy := 6 8 r_eshape (0 1 1 1 1 0 0 0) c_at (0 1 1 1 1 0 0 0) c_at (8 r_eshape 0) c_at (8 r_eshape 1) c_at (0 0 0 1 1 1 1 0) c_at 0 0 0 1 1 1 1 0
oz := 6 8 r_eshape (0 0 0 1 1 1 1 0) c_at (0 0 0 1 1 1 1 0) c_at (0 0 0 1 1 1 1 0) c_at (0 0 0 1 1 1 1 0) c_at (8 r_eshape 0) c_at 8 r_eshape 1

# vx:e_dges f: the faces' outlines as segments for scene: 8 points a
# face (4 edges, 2 points each), n*8 by 3, the chunk centered on the
# origin and scaled to -1..1
l:e_dges := { f ->
  d := 1 + 4 s_elect_2 f
  z8 := 8 r_eshape 0
  px := (d s_elect ox) + (1 s_elect_2 f) '+ t_able z8
  py := (d s_elect oy) + (2 s_elect_2 f) '+ t_able z8
  pz := (d s_elect oz) + (3 s_elect_2 f) '+ t_able z8
  p := 2 1 t_ranspose (3 c_at 8 * t_ally f) r_eshape (r_avel px) c_at (r_avel py) c_at r_avel pz
  ((f_loat p) - 8.0) / 8.0
}

# each block's color, red green blue (air first)
l:colors := 8 3 r_eshape 0 0 0  0.55 0.55 0.58  0.55 0.38 0.22  0.35 0.7 0.25  0.9 0.82 0.55  0.25 0.45 0.9  0.45 0.3 0.15  0.2 0.5 0.2

# vx:q_uads f: the faces as filled quads for scene: each face's four
# corners in order round it (the outlines' corners 1 3 5 7), n*4 by 3,
# centered and scaled like vx:e_dges
cx := 1 3 5 7 s_elect_2 ox
cy := 1 3 5 7 s_elect_2 oy
cz := 1 3 5 7 s_elect_2 oz
l:q_uads := { f ->
  d := 1 + 4 s_elect_2 f
  z4 := 4 r_eshape 0
  px := (d s_elect cx) + (1 s_elect_2 f) '+ t_able z4
  py := (d s_elect cy) + (2 s_elect_2 f) '+ t_able z4
  pz := (d s_elect cz) + (3 s_elect_2 f) '+ t_able z4
  p := 2 1 t_ranspose (3 c_at 4 * t_ally f) r_eshape (r_avel px) c_at (r_avel py) c_at r_avel pz
  ((f_loat p) - 8.0) / 8.0
}
