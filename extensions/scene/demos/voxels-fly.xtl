## Voxels, 7: flying. The endless world of voxels-endless, now from the
## air: F switches between walking and flying. Flying moves level
## whatever you look at -- W forward, S back, A and D sideways -- Space
## rises and Shift sinks, with no gravity, the blocks still stopping you;
## so you can look down at the land as you cross it. F again drops you
## back to walking wherever you are. The columns are made ahead, one a
## frame, and dropped behind, under fog and a curved horizon.
## Run: just demo scene voxels-fly
##   F fly or walk; flying: W A S D level, Space up, Shift down; walking:
##   Space jump or swim up, Shift run; drag the mouse or the arrows to
##   look, H: back to the start, q quit

"en:" u_se< "Endless"
"sc:" u_se< "Scene"

w := "Voxels 7: flying -- X_eTaL" sc:o_pen! 640 400
g := w sc:f_og! 22.0 44.0
k := w sc:s_ky! 0.55 0.72 0.92
k := w sc:c_urve! 160.0

"keys: F fly or walk; flying: W A S D level, Space up, Shift down; walking: Space jump/swim, Shift run; drag or arrows look; H home; q quit"

## the world around the start made before the first frame: each column
## takes three steps
s := en:n_ew w
s := (3 * (1 + 2 * en:reach) * 1 + 2 * en:reach) 'en:s_tream p_ower s
"columns made at the start:"
t_ally en:k_eys s

## one frame: an event, then a third of a column's work, then the
## player
u:f_rame := { s ->
  en:s_topped s ? s
  v := sc:n_ext! w
  ((v m_atch "close") + (v m_atch "key q") + v m_atch "key Escape") > 0 ? en:s_top s
  s := (v m_atch "key h") u:i_f s
  s := en:s_tream s
  s := (v m_atch "key f") u:f_ly s
  s en:m_ove sc:c_ontrols w
}
u:i_f := { yes s ->
  yes ? en:h_omeAgain s
  s
}
u:f_ly := { yes s ->
  yes ? en:t_oggleFly s
  s
}
last := 100000 'u:f_rame p_ower s
z := sc:c_lose! w
"where it ended (x y z, blocks), the columns kept:"
(f_loat f_loor 0.5 + 3 t_ake en:p_layer last) c_at f_loat t_ally en:k_eys last
"bye"
