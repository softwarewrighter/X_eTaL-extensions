## Voxels, 9: a quarter turn, seen. One layer of the Rubik's cube -- 9
## cubies, a "plane" -- turns a quarter revolution while the rest stays
## still: its cubies' bodies and stickers rotated a little more each
## frame (a rotation matrix, one inner product), then the cube's colors
## permuted once it is done. A scramble: twelve quarter turns, each on
## a different axis from the one before (the faces in the order U R F
## D L B, twice), the directions + + - - + - and then - + + + - +; a
## pause; then the same turns undone in reverse, back to solved.
## Run: just demo scene voxels-rubik-turn   (drag to turn it; q quit)

"rb:" u_se< "Rubik"
"sc:" u_se< "Scene"

w := "Voxels 9: a quarter turn -- X_eTaL" sc:o_pen! 560 560
k := w sc:c_amera! 0.6 0.45 7.5 0.0

## the scramble, in the order of rb:names: U R' ... -- each turn on
## another axis than the one before -- then the way back: the same
## turns undone, last first
scramble := 1 5 10 4 7 12 2 5 9 3 8 11
turns := scramble c_at rb:u_ndo r_ev scramble
## frames for a quarter turn, still after it, and still at the
## scrambled cube before solving
frames := 20
rest := 8
pause := 50

names := (n_ot rb:names = f_irst " ") p_artition rb:names

## (colors, turn, frame) u:p_aint 0: the cube drawn at this frame of
## the turn -- turning, or (at its end) with the turn made
u:p_aint := { (c, i, f) z ->
  f < frames ? (c, i, (f_loat f + 1) / f_loat frames) rb:d_raw w
  f = frames ? (i rb:t_urn c, 0, 0.0) rb:d_raw w
  0
}

## (turn, frame) u:a_fter c: the colors after this frame: turned once,
## at the turn's end
u:a_fter := { (i, f) c ->
  f = frames ? i rb:t_urn c
  c
}

## the turn about to be shown, printed (and the start of each half)
u:a_nnounce := { yes j ->
  0 = yes ? 0
  k := 1 + (j - 1) m_od t_ally turns
  i := k s_elect turns
  said := (k = 1) u:s_ay "scrambling"
  said := (k = 1 + t_ally scramble) u:s_ay "solving"
  said := p_rint! "turn " c_at d_isclose i s_elect names
  0
}
u:s_ay := { yes m ->
  0 = yes ? 0
  said := p_rint! m
  0
}

## one frame of the show: the state is (colors, which turn, its frame,
## running)
u:s_how := { (c, j, f, on) ->
  i := (1 + (j - 1) m_od t_ally turns) s_elect turns
  said := (f = 0) u:a_nnounce j
  drawn := (c, i, f) u:p_aint 0
  c := (i, f) u:a_fter c
  wait := rest + pause * (0 = (j m_od t_ally scramble))
  f < frames + wait ? (c, j, f + 1, on)
  (c, j + 1, 0, on)
}

u:f_rame := { st ->
  (c, j, f, on) := st
  0 = on ? st
  v := sc:n_ext! w
  ((v m_atch "close") + v m_atch "key q") > 0 ? u:q_uit st
  u:s_how st
}
u:q_uit := { (c, j, f, on) ->
  z := sc:c_lose! w
  (c, j, f, 0)
}
shown := (rb:solved, 0, 0.0) rb:d_raw w
last := 100000 'u:f_rame p_ower (rb:solved, 1, 0, 1)
"bye"
