"vx:" u_se< "Voxels"
(3 vx:h_ash 4) = 3 vx:h_ash 4
h := vx:h_eightsAt 0 0 32
('m_in r_/ r_avel h) c_at 'm_ax r_/ r_avel h
# seams: the heights of column (1,0) start where (0,0)'s neighbors were
a := vx:h_eightsAt 0 0 18
b2 := vx:h_eightsAt 16 0 2
(16 17 s_elect r_avel 1 s_elect_2 a) c_at r_avel 1 s_elect_2 b2
t0 := []TS
p := vx:p_atch 0 0
t1 := []TS
s_hape d_isclose 1 s_elect p
s_hape d_isclose 2 s_elect p
u:m_s := { a z -> f_loat '+ r_/ 3600000 60000 1000 1 * -4 t_ake z - a }
t0 u:m_s t1
