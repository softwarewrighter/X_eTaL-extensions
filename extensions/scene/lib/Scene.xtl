# Scene.xtl -- the facade of the scene extension: retained 3D line and point scenes in a native window, patched by id
# Import: "sc:" u_se< "Scene"
# Run with xetal-x (xetal-x --ext DIR puts this directory on XETAL_PATH)
# until X_eTaL can call native code itself; the private helpers below
# speak the ext: channel (docs/bridge.md) so programs never do.

# private: the ext: channel
c_all := { p -> []N_GET "ext:scene/" c_at p }
s_hapeOf := { p -> f_loor n_umbers c_all p c_at "?shape" }
t_ext := { t p -> t []N_PUT "ext:scene/" c_at p c_at "?text" }
f_loats := { x p -> (f_ormat r_avel f_loat x) []N_PUT "ext:scene/" c_at p c_at "?float=" c_at f_ormat s_hape x }
n_umber := { p -> f_irst n_umbers c_all p }

# The extension's name and version.
l:a_bout := { @ -> c_all "about" }
