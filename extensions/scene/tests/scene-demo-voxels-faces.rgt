command = 'rm -rf work/vf && XETAL_HEADLESS=1 XETAL_EVENTS="frame,frame,frame" XETAL_FRAMES=work/vf xetal-x --ext .. run demos/voxels-faces.xtl && cksum work/vf/*.png'
exit_code = 0
desc = "voxels 2: exposed faces on known shapes (1, 256, 452, 2048 a direction) and the chunk (1389 of 10446); three headless frames pinned"
