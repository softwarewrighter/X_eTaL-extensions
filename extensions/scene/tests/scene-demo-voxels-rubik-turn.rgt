command = 't=$(mktemp -d) && XETAL_HEADLESS=1 XETAL_EVENTS="frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame," XETAL_FRAMES_ONLY=8,25,95 XETAL_FRAMES=$t xetal-x --ext .. run demos/voxels-rubik-turn.xtl && cd $t && cksum scene-1-8.png scene-1-25.png scene-1-95.png'
exit_code = 0
desc = "voxels 9: a layer turned a quarter revolution, seen (U, U prime, R): three frames pinned, mid-turn and after"
