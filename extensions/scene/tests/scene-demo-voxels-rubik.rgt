command = 't=$(mktemp -d) && XETAL_HEADLESS=1 XETAL_EVENTS="frame,key u,frame,key R,frame,key z,frame,key z,frame,key Space,frame,frame" XETAL_FRAMES_ONLY=1,3,8 XETAL_FRAMES=$t xetal-x --ext .. run --seed 1 demos/voxels-rubik.xtl && cd $t && cksum scene-1-1.png scene-1-3.png scene-1-8.png'
exit_code = 0
desc = "voxels 8: the cube checked (permutations, order 4, inverses, R U R prime U prime order 6, R U order 105, directions), turned by keys, undone to solved, scrambled; three frames pinned"
