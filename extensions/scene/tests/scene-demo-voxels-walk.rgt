command = "t=$(mktemp -d) && XETAL_HEADLESS=1 XETAL_EVENTS='frame,frame,keydown w,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,drag 300 0,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,keydown space,frame,keyup space,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,key c,keyup w,frame' XETAL_FRAMES_ONLY=2,40,70 XETAL_FRAMES=$t xetal-x --ext .. run --seed 1 demos/voxels-walk.xtl && cd $t && cksum scene-1-2.png scene-1-40.png scene-1-70.png"
exit_code = 0
desc = "voxels 5: walking (seed 1) with scripted keys and a drag: chunks in view before and after turning; three first-person frames pinned"
