command = "mkdir -p work/vk && XETAL_HEADLESS=1 XETAL_EVENTS='frame,frame,keydown w,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,drag 300 0,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,keydown space,frame,keyup space,frame,frame,frame,frame,frame,frame,frame,frame,frame,frame,key c,keyup w,frame' XETAL_FRAMES=work/vk xetal-x --ext .. run --seed 1 demos/voxels-walk.xtl && cksum work/vk/scene-1-2.png work/vk/scene-1-40.png work/vk/scene-1-70.png"
