scene 0.1.0
  scene/open : Num a => Char -> a -> Int    # title open width height: a 3D scene window; its id.
  scene/polyline : (Num a, Num b) => a -> b -> Int    # scene object red green blue polyline points (n by 3): joined in order.
  scene/segments : (Num a, Num b) => a -> b -> Int    # header segments points: taken in pairs.
  scene/dots : (Num a, Num b) => a -> b -> Int    # header dots points: each a dot.
  scene/quads : (Num a, Num b) => a -> b -> Int    # header quads points (4n by 3): filled, shaded, depth-tested.
  scene/fog : (Num a, Num b) => a -> b -> Int    # scene fog near far: quads fade into the background.
  scene/remove : (Num a, Num b) => a -> b -> Int    # scene remove object: 1 if it was there.
  scene/camera : (Num a, Num b) => a -> b -> Int    # scene camera yaw pitch distance spin.
  scene/eye : (Num a, Num b) => a -> b -> Int    # scene eye x y z yaw pitch: a first-person camera.
  scene/sky : (Num a, Num b) => a -> b -> Int    # scene sky red green blue: the background and fog color.
  scene/curve : (Num a, Num b) => a -> b -> Int    # scene curve radius: a curved horizon (0: flat).
  scene/overlay : (Num a, Num b) => a -> b -> Int    # scene overlay rects (n by 7: x y width height red green blue, logical pixels): drawn over the scene.
  scene/controls : Num a => a -> Float    # Mouse drag dx dy since last asked, then held: w a s d space shift left right up down.
  scene/next : Num a => a -> Char    # The next event (frame, key NAME, click left|right X Y, close), waiting up to a frame.
  scene/close : Num a => a -> Int    # Close the window.
