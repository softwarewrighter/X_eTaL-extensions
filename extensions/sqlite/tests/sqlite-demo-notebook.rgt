command = "mkdir -p work && xetal-x --ext . run --draw work/draw demos/notebook.xtl && cksum work/draw/notebook-1.svg work/draw/notebook-2.svg"
exit_code = 0
desc = "demos/notebook.xtl: CO2 at Mauna Loa through SQLite, SQL groups, X_eTaL analytics, a histogram and the curve as SVG (pinned by cksum)"
