sqlite 0.1.0
  sqlite/exec : Char -> Char -> Int    # db exec sql: run the statements; rows changed.
  sqlite/nums : Char -> Char -> Float    # db nums sql: the result as a Float matrix (NULL is NaN).
  sqlite/texts : Char -> Char -> Char    # db texts sql: every cell as text, one row per cell.
  sqlite/cols : Char -> Char -> Char    # db cols sql: the column names, one per row.
  sqlite/quote : a -> Char    # x as an SQL literal (text quoted, quotes doubled).
