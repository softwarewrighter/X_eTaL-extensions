# three -- interactive 3D in a browser: scenes drawn by Three.js from the calls X_eTaL writes. `just` lists recipes.
# Run from this directory (or `just ext three RECIPE` from the repo root).

set positional-arguments

root := "../.."
port := "8470"

# List the recipes
default:
    @just --list

# Build the native library (target/debug/libxetal_ext_three.dylib or .so) and xetal-x
build:
    cd {{root}} && cargo build -q --workspace

# Rust tests  and the reg-rs tests
test: test-rust reg

# Rust tests of the crate in rust/
test-rust:
    cargo test -q -p xetal-ext-three

# reg-rs tests in tests/ (baselines committed there)
reg:
    {{root}}/scripts/reg-ext.sh three run

# Show the reg-rs failures in full
reg-diff:
    {{root}}/scripts/reg-ext.sh three run -vv

# Accept the latest output of one reg-rs test as its baseline (review the diff)
rebase test:
    {{root}}/scripts/reg-ext.sh three rebase -p "$1"

# The functions this extension exports, as xetal-x sees them
list: build
    {{root}}/target/debug/xetal-x --ext . --ext-list

# Run a demo: just demo NAME (demos/NAME.xtl; pictures go to work/draw/; the blender extension's scene libraries, NeonCity, on XETAL_PATH)
demo name: build
    XETAL_PATH="{{root}}/extensions/blender/demos" {{root}}/target/debug/xetal-x --ext {{root}}/extensions run --draw work/draw "demos/$1.xtl"

# The neon city as a directory to serve (work/city): demos/city.xtl, and the screens' pictures beside it
city: (demo "city")
    mkdir -p work/city/media && cp web/static/media/* work/city/media/

# A small board as a directory to serve (work/board): tests/board.xtl, drawn by the board player
board: build
    {{root}}/target/debug/xetal-x --ext {{root}}/extensions run tests/board.xtl

# The screens' pictures, made small from media.toml into web/static/media (commit them)
media:
    {{root}}/scripts/city-media.py

# Serve a written scene: just serve city (work/city at http://127.0.0.1:8470/)
serve name:
    {{root}}/.venv/bin/python3 -m http.server {{port}} --bind 127.0.0.1 -d "work/$1"

# The live page (X_eTaL as WebAssembly builds the city from a seed), built with trunk into web/dist
live:
    cd web && trunk build --release --filehash false --public-url ./

# Serve the live page at http://127.0.0.1:8470/
live-serve: live
    {{root}}/.venv/bin/python3 -m http.server {{port}} --bind 127.0.0.1 -d web/dist

# The ride as a video from the page itself, by headless Chrome (work/city/ride.mp4; needs `just city` first and port 8470 free)
ride:
    {{root}}/scripts/three-ride.sh

# Publish the live page on the site (pages/three/live)
publish:
    {{root}}/scripts/publish-three.sh
