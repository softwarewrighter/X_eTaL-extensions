command = "t=$(mktemp -d) && XETAL_THREE_ROOT=$t xetal-x --ext .. run tests/board.xtl && cd $t && find work/board -type f | sort | grep -v vendor && cat work/board/scene.calls.js"
exit_code = 0
desc = "a board of seven calls (view, camera, two kinds of tiles as columns and one drawn with a model, two pieces): counted by th:s_how! and written by th:p_age! as a directory to serve, 19 files with board.js, the board player, among them; the calls are written as they were given"
