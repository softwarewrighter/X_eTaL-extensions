command = 't=$(mktemp -d) && XETAL_THREE_ROOT=$t XETAL_PATH="$PWD/../blender/demos:$XETAL_PATH" xetal-x --ext .. run demos/city.xtl && grep -c . $t/work/city/scene.calls.js'
exit_code = 0
desc = "the neon city (blender demos/NeonCity.xtl) as a page to serve: 69 calls shown, 24 files written, 69 lines of calls in scene.calls.js"
