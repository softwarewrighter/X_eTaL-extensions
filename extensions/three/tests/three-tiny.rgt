command = "t=$(mktemp -d) && XETAL_THREE_ROOT=$t xetal-x --ext .. run tests/tiny.xtl && cd $t && find work/tiny -type f | sort"
exit_code = 0
desc = "a scene of three calls: counted by th:s_how! (nothing is drawn from the command line) and written by th:p_age! as a directory to serve: the page, the player, the controls, the calls and Three.js, 16 files"
