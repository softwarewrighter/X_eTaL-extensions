## The neon city's film, for the render farm (farm/jobs.toml, job
## city-film): the scene's script -- Cycles.xtl's player and the city of
## the film's seed -- written to work/farm/city/scene.py, with nothing
## in it that renders: scripts/farm.py gives each machine its frames.
## 1920 by 1080, 30 frames a second, 128 samples, on the graphics card.
## Run from the repository's root: scripts/farm-scene.sh farm/city-film.xtl

"bl:" u_se< "Blender"
"cy:" u_se< "Cycles"
"nc:" u_se< "NeonCity"

script := cy:head c_at (nc:seed, "extensions/three/web/static/media", 1920, 1080, 30, 128, "GPU") nc:c_ity 0
"the scene's script, in bytes:"
"work/farm/city/scene.py" bl:w_rite! script
