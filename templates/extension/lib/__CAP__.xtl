# __CAP__.xtl -- the facade of the __NAME__ extension: __WHAT__
# Import: "__ALIAS__:" u_se< "__CAP__"
# Run with xetal-x (xetal-x --ext DIR puts this directory on XETAL_PATH).
# Each signature line is written out by the binding macro (lib/Ffi.xtlm,
# docs/ffi-macro.md).
"ffi:" u_se< "Ffi"

# The extension's name and version.
"a_bout : unit -> text"         ffi:b_ind< "__NAME__/about"

# The native package behind these functions (a literal l: name also
# makes this file a library to `xetal type`: ask E7).
l:package := "__NAME__"
