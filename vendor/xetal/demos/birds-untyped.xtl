#!/usr/bin/env -S xetal run --untyped
# The birds that apply an argument to itself have no finite type, so
# this file runs with --untyped (just show applies its #! flags).
# docs/birds.md lists every bird; the typed ones are the Combinators
# library.

u:M_ := { x_ -> x_ 'x_ }                  # Mockingbird: M x = x x
u:L_ := { x_ y_ -> x_ y_ 'y_ }            # Lark: L x y = x (y y)
u:M_2 := { x_ y -> y x_ (x_ y) }         # Double Mockingbird: M2 x y = x y (x y)
u:U_ := { x_ y_ -> y_ ('x_ x_ 'y_) }      # Turing bird: U x y = y (x x y)

# M applied to the identity gives the identity back.
u:I_ := { x -> x }
('u:I_ u:M_)_ 42

# The textbook Sage Bird, from self-application: Y f = f (Y f). The
# factorial's self parameter is lazy (~), so the unfolding stops.
u:Y_ := { f_ -> { x_ -> f_ x_ 'x_ } '{ x_ -> f_ x_ 'x_ } }
u:F_ := { ~s_elf n -> n <= 1 ? 1; n * s_elf n - 1 }
(u:Y_ 'u:F_)_ 5

# Z, the Sage Bird for strict languages: the self-application is
# wrapped in a lambda, so it waits until the argument arrives.
u:Z_ := { f_ -> { x_ -> f_ '{ v -> 'x_ x_ v } } '{ x_ -> f_ '{ v -> 'x_ x_ v } } }
u:G_ := { s_elf n -> n <= 1 ? 1; n * s_elf n - 1 }
(u:Z_ 'u:G_)_ 6

# Turing's fixed point, U U: (U U) f is f ((U U) f).
('u:U_ u:U_ 'u:F_)_ 4
