#!/usr/bin/env xetal
# Base conversion: e_ncode writes a number in any radix, d_ecode reads
# it back. A radix can change from digit to digit, which is how clocks,
# calendars and old measures count.
2 2 2 2 2 2 2 2 e_ncode 200
2 d_ecode 1 1 0 0 1 0 0 0
8 8 8 e_ncode 493                    # octal 755, the file mode
16 16 e_ncode 255

# As many digits as a number needs: encode with plenty, then keep the
# digits from the first one that is not 0 (an or-scan of the mask, by
# replicate).
u:d_igits := { b n ->
  d := (40 r_eshape b) e_ncode n
  ('| s_\ 0 != d) r_eplicate d
}
2 u:d_igits 2026
16 u:d_igits 48879
10 u:d_igits 1234567

# Hexadecimal as text, and back.
hex := "0123456789ABCDEF"
(1 + 16 u:d_igits 48879) s_elect hex
16 d_ecode -1 + hex i_ndexOf "BEEF"
16 d_ecode -1 + hex i_ndexOf "7FFFFFFFFFFFFFFF"   # the largest Int

# Several numbers at once: one column each.
2 2 2 2 e_ncode 3 5 9 12

# Mixed radixes: a million seconds in days, hours, minutes, seconds;
# and back.
0 24 60 60 e_ncode 1000000
0 24 60 60 d_ecode 11 13 46 40
# 100 inches in yards, feet and inches.
0 3 12 e_ncode 100

# Gray code: each number's bits, each differing from the bit above it,
# so neighbours differ in one bit only.
b := 2 2 2 e_ncode o_ffsets 8
g := 0 + b != (1 8 r_eshape 0) c_at -1 d_rop b
g
2 d_ecode g
