#!/usr/bin/env xetal
# The Collatz sequence: halve an even number, otherwise triple it and
# add one (the numbers rise and fall like hailstones); every start
# tried so far reaches 1. A small iteration with a predicate, and then
# the same question asked of many starts at once.
u:h_ail := { n -> 0 = n m_od 2 ? n d_iv 2; 1 + 3 * n }
u:c_ollatz := { n -> n = 1 ? 1 r_eshape 1; n c_at u:c_ollatz u:h_ail n }
u:c_ollatz 6
t_ally u:c_ollatz 27         # 27 takes 111 steps, 112 numbers
'm_ax r_/ u:c_ollatz 27      # climbing as high as 9232

# Steps to reach 1 for every start from 1 to 30, and the longest.
s := '{ (t_ally u:c_ollatz _r) - 1 } e_ach r_ange 30
s
(s i_ndexOf 'm_ax r_/ s) c_at 'm_ax r_/ s
