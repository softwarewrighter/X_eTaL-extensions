#!/usr/bin/env xetal
# Fibonacci five ways: a recursion as a scalar language writes it, a
# vector grown by adding its last two items, powers of a matrix (an
# inner product), the array way, and recursion with no name at all,
# through the Y combinator, at run time and when the program is
# expanded.

# 1. The definition, run on each of 0 to 14.
u:f_ib := { n -> n < 2 ? n; (u:f_ib n - 1) + u:f_ib n - 2 }
'u:f_ib e_ach o_ffsets 15

# 2. Growing the sequence: each step appends the sum of the last two.
u:f_ibs := { n ->
  n <= 2 ? n t_ake 0 1
  f := u:f_ibs n - 1
  f c_at '+ r_/ -2 t_ake f
}
u:f_ibs 20

# 3. The matrix 1 1 over 1 0, to the power n, holds F(n+1) F(n) over
# F(n) F(n-1): `'+ '* i_nner` is the matrix product.
q := 2 2 r_eshape 1 1 1 0
u:p_ow := { n -> n = 1 ? q; q '+ '* i_nner u:p_ow n - 1 }
u:p_ow 10
2 s_elect r_avel u:p_ow 30    # F(30)

# 4. Recursion without naming itself: u:F_ib is handed the function to
# call for the smaller cases (its self parameter), and c:Y_ (the Sage
# Bird of the Combinators library) ties the knot: Y f is f (Y f). The
# self parameter is lazy (~), so Y f unfolds only as far as it is used.
"c:" u_se< "Combinators"
u:F_ib := { ~s_elf n -> n < 2 ? n; (s_elf n - 1) + s_elf n - 2 }
'{ 'u:F_ib c:Y_ _r } e_ach o_ffsets 15

# 5. The knot tied when the program is expanded: c:Y_< (from
# Combinators.xtlm, found with Combinators.xtl under the same alias)
# writes the name in place of the self parameter, so the result is the
# plain named recursion of way 1, with no lazy parameter and no
# combinator left to run (`xetal expand` shows what it wrote).
"u:f_ib5" c:Y_< "{ ~s_elf n -> n < 2 ? n; (s_elf n - 1) + s_elf n - 2 }"
'u:f_ib5 e_ach o_ffsets 15
