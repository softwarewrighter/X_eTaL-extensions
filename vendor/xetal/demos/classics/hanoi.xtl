#!/usr/bin/env xetal
# The Tower of Hanoi: move n disks from one peg to another, one at a
# time, never a larger on a smaller. Recursion is the natural way to
# say it, even in APL: move n - 1 out of the way, move the largest,
# move the n - 1 back on top. "just draw demos/classics/hanoi.xtl"
# watches four disks move.

# `n u:h_anoi pegs` lists the moves, one row each: from peg, to peg
# (`1 3` moves the top disk from peg 1 to peg 3); pegs is from, to and
# the spare. Each half permutes the pegs with s_elect.
u:h_anoi := { n pegs ->
  n = 0 ? 0 2 r_eshape 0
  first := (n - 1) u:h_anoi 1 3 2 s_elect pegs
  last := (n - 1) u:h_anoi 3 2 1 s_elect pegs
  first c_at (1 2 r_eshape 2 t_ake pegs) c_at last
}
3 u:h_anoi 1 3 2
'{ t_ally _r u:h_anoi 1 3 2 } e_ach r_ange 10   # 2^n - 1 moves

# -- Every move at once ------------------------------------------------------
# The array way: no recursion. Move k moves disk 1 + (the trailing zero
# bits of k), counted here by how many powers of 2 divide k (a table of
# remainders). Each disk cycles round the pegs in one direction, set by
# whether n - d is even, and has moved k d_iv 2^d times before, so its
# pegs are those counts taken round the cycle. The from and to columns
# are put side by side by two tables against 0 0 and 0 1.
u:m_oves := { n ->
  k := r_ange (2 ^ n) - 1
  d := 1 + '+ r_/_2 0 = k 'm_od t_able 2 ^ r_ange n
  m := k d_iv 2 ^ d
  s := 1 + 0 = (n - d) m_od 2
  from := 1 + (s * m) m_od 3
  to := 1 + (s * m + 1) m_od 3
  (from '+ t_able 0 0) + (to - from) '* t_able 0 1
}
u:m_oves 3
'{ (u:m_oves _r) m_atch _r u:h_anoi 1 3 2 } e_ach r_ange 10   # the same moves

# docs/literate/hanoi.org walks through both, and a third, curried with
# the combinators.

# -- Watching it ------------------------------------------------------------
# The state is where each disk is: p has one peg per disk, smallest
# first. A move takes the smallest disk on its first peg (the first
# place p holds it, by i_ndexOf) to its second.
u:m_ove := { p m ->
  from := 1 s_elect m
  disk := p i_ndexOf from
  p + ((2 s_elect m) - from) * disk = r_ange t_ally p
}
(3 r_eshape 1) u:m_ove 1 3

# The pegs as a matrix of disk sizes, top to bottom (0 for none): the
# disks on a peg are `w_here p = j`, smallest first, padded at the top
# by a negative take (after a 0, since an empty array has no fill).
u:s_lots := { p ->
  n := t_ally p
  (r_ange n) '{ r j -> r s_elect (0 - n) t_ake 0 c_at w_here p = j } t_able 1 2 3
}
u:s_lots 1 2 3

# Drawn: each disk a bar as wide as twice its size less one, centred
# on its peg (a table of sizes against offsets from the centre).
u:p_icture := { p ->
  n := t_ally p
  w := 1 + 2 * n
  bars := (u:s_lots p) '{ s x -> s > a_bs x } t_able (o_ffsets w) - n
  (n c_at 3 * w) r_eshape r_avel bars
}

# Every state, the start and one after each move, stacked as frames.
u:p_lane := { m -> (1 c_at s_hape m) r_eshape m }
u:p_lay := { p moves ->
  frame := u:p_lane u:p_icture p
  0 = t_ally moves ? frame
  frame c_at (p u:m_ove f_irst moves) u:p_lay 1 d_rop moves
}
moves := 4 u:h_anoi 1 3 2
s_hape (4 r_eshape 1) u:p_lay moves
watched := []S_HOW []G_RID (4 r_eshape 1) u:p_lay moves
