#!/usr/bin/env xetal
# Conway's Life, drawn: each generation a frame, the frames shown in
# turn. "just draw demos/classics/life-drawn.xtl" runs it and opens the
# first picture in the browser; "xetal run --draw DIR FILE" writes the
# pictures to DIR, as life-drawn-1.svg, life-drawn-2.svg.

# The one-line rule (demos/life.xtl explains it). Rotating wraps round,
# so the board is a torus: what leaves one edge comes back at the other.
u:l_ife := { ('+ r_/_12 -1 0 1 o_-_12 _r) { (_l = 3) + _r * _l = 4 } _r }

# `n u:f_rames b` stacks b and the n - 1 generations after it along a
# new leading axis: a rank-3 array, which `[]G_RID` draws as frames.
u:f_rames := { n b ->
  n = 1 ? (1 c_at s_hape b) r_eshape b
  b c_at (n - 1) u:f_rames u:l_ife b
}

# -- On a torus -----------------------------------------------------------
# A glider in the corner of a 10 by 10 board (`t_ake_2` pads the columns,
# `t_ake` the rows). It moves one cell diagonally every 4 generations,
# so after 40 it is home again and the animation loops seamlessly.
glider := 10 t_ake 10 t_ake_2 3 3 r_eshape 0 1 0 0 0 1 1 1 1
(u:l_ife^40 glider) m_atch glider
torus := []S_HOW []G_RID 40 u:f_rames glider

# -- In a box ---------------------------------------------------------------
# Without wrapping, the world ends at its edge. A border of cells kept
# dead does it: multiplying by a mask of 1s inside and 0s round the edge
# after every step, so nothing reaches round to the other side.
row := 0 c_at (10 r_eshape 1) c_at 0
mask := row '* t_able row
u:b_oxed := { mask * u:l_ife _r }
u:b_oxedFrames := { n b ->
  n = 1 ? (1 c_at s_hape b) r_eshape b
  b c_at (n - 1) u:b_oxedFrames u:b_oxed b
}
# The same glider, one cell in from the corner of a 12 by 12 board: it
# runs into the far corner and settles there as a 2 by 2 block.
# (`-1 o_-` moves it down a row, `-1 o_-_2` right a column.)
start := -1 o_- -1 o_-_2 12 t_ake 12 t_ake_2 3 3 r_eshape 0 1 0 0 0 1 1 1 1
boxed := []S_HOW []G_RID 40 u:b_oxedFrames start
'+ r_/_12 u:b_oxed^40 start   # four cells: the block
