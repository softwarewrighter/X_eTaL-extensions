#!/usr/bin/env xetal
# Magic squares: the numbers 1 to n*n in an n by n square whose rows,
# columns and both diagonals all have the same sum. For odd n, the
# Siamese method (de la Loubere, 1693) walks up and to the right; the
# array way sees the square it makes as two cyclic Latin squares, each
# a stack of rotations of one row, so no walk is needed.
n := 5
o := o_ffsets n
h := (n + 1) d_iv 2

# A list of amounts rotates the row once for each: a Latin square.
a := (h + o) o_- o
a
b := (h * o) o_- (1 + 2 * o) m_od n
b
m := 1 + (n * a) + b             # a gives the n's, b the units
m

# Every column, every row, both diagonals: n (n*n + 1) / 2.
'+ r_/ m
'+ r_/_2 m
'+ r_/ '+ r_/ m * o '= t_able o
'+ r_/ '+ r_/ m * o '= t_able r_ev o
(s_ort (n * n) r_eshape m) m_atch r_ange n * n

# As functions: a Siamese square for any odd n, and the test.
u:s_iamese := { n ->
  o := o_ffsets n
  h := (n + 1) d_iv 2
  1 + (n * (h + o) o_- o) + (h * o) o_- (1 + 2 * o) m_od n
}
u:m_agic := { m ->
  n := t_ally m
  s := (n * 1 + n * n) d_iv 2
  o := o_ffsets n
  r := '& r_/ s = ('+ r_/ m) c_at '+ r_/_2 m
  d := s = '+ r_/ '+ r_/ m * o '= t_able o
  e := s = '+ r_/ '+ r_/ m * o '= t_able r_ev o
  r & d & e & (s_ort (n * n) r_eshape m) m_atch r_ange n * n
}
u:s_iamese 3
'[u:m_agic u:s_iamese] e_ach 3 5 7 9 11
u:m_agic u:s_iamese 7
u:m_agic 3 3 r_eshape r_ange 9    # counting is not magic
shown := []S_HOW []G_RID u:s_iamese 7

# A doubly even square by complement: count 1 to 16 row by row, then
# where the row and the column are both outer or both inner (the two
# diagonals), put 17 minus the count. Swapping the middle columns gives Durer's square from
# Melencolia I, dated 1514 in its bottom row.
k := 4 4 r_eshape r_ange 16
c := 1 0 0 1
d := k + (17 - 2 * k) * c '= t_able c
d
durer := 1 3 2 4 s_elect_2 d
durer
u:m_agic durer
