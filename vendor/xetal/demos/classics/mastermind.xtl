#!/usr/bin/env xetal
# Mastermind: a hidden code of four pegs in six colours (1 to 6). Each
# guess is scored with a black peg for every right colour in the right
# place and a white peg for every other right colour. A game against
# the computer is demos/classics/mastermind-play.xtl; here, the scoring
# and a player that asks every possible code at once.
secret := 1 1 2 3
guess := 3 1 1 4
'+ r_/ secret = guess                 # black: equal in place
c := '+ r_/_2 (r_ange 6) '= t_able secret
c                                     # how many of each colour
c m_in '+ r_/_2 (r_ange 6) '= t_able guess   # colours both have

# The score, black then white: the colours in common, less the blacks.
u:s_core := { s g ->
  black := '+ r_/ s = g
  both := '+ r_/ ('+ r_/_2 (r_ange 6) '= t_able s) m_in '+ r_/_2 (r_ange 6) '= t_able g
  black c_at both - black
}
secret u:s_core guess
secret u:s_core secret

# Every code, 6^4 of them: the digits of 0 to 1295 in base 6, plus
# one. Encode gives one column per number; transpose makes each a row.
codes := o_\ 1 + 6 6 6 6 e_ncode o_ffsets 1296
t_ally codes
3 t_ake codes

# One guess scored against every code at once, as 10 black + white.
u:s_cores := { c g ->
  n := t_ally c
  black := '+ r_/_2 c = (n c_at 4) r_eshape g
  have := '+ r_/_2 c '= t_able r_ange 6
  want := (n c_at 6) r_eshape '+ r_/_2 (r_ange 6) '= t_able g
  both := '+ r_/_2 have m_in want
  (10 * black) + both - black
}
x := codes u:s_cores 1 1 2 2
5 t_ake x
u_nique x                             # the scores 1 1 2 2 can get

# A player: guess the first code still possible, keep only the codes
# that would have scored the same, and go on. Each row is a guess and
# its score.
u:s_olve := { c s ->
  g := 4 r_eshape 1 s_elect c
  r := s u:s_core g
  row := 1 6 r_eshape g c_at r
  k := '+ r_/ 10 1 * r
  4 = f_irst r ? row; row c_at ((w_here k = c u:s_cores g) s_elect c) u:s_olve s
}
codes u:s_olve 6 5 3 3
secrets := 3 4 r_eshape 4 1 6 2 5 3 3 6 2 4 1 5
'{ t_ally codes u:s_olve 4 r_eshape _r s_elect secrets } e_ach r_ange 3

# How many guesses, for every 37th code (35 of them).
n := '{ t_ally codes u:s_olve 4 r_eshape (37 * _r) s_elect codes } e_ach r_ange 35
'+ r_/_2 (r_ange 8) '= t_able n       # games won in 1, 2, ... 8
(f_loat '+ r_/ n) / f_loat t_ally n   # the average
