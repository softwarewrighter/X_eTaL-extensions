#!/usr/bin/env xetal
# Pascal's triangle, the classic array construction: each row is the
# row before it added to itself shifted one place. Run it with
# "just show demos/classics/pascal.xtl" to see each line beside its
# output.

# -- Shift and add ----------------------------------------------------------
# A row kept at a fixed width, zeros on the right: rotating it one place
# toward the back (`-1 o_-`) shifts it right, and the zero that wraps
# round to the front keeps it a shift. Adding the two gives the next row.
u:n_ext := { _r + -1 o_- _r }
u:n_ext 1 0 0 0 0
u:n_ext^4 1 0 0 0 0      # a superscript repeats a function: row 5

# Every row at once: `n u:r_ows r` stacks r and the n - 1 rows after it,
# one per major cell (`c_at` joins a vector to a matrix as a row).
u:r_ows := { n r ->
  n = 1 ? (1 c_at s_hape r) r_eshape r
  r c_at (n - 1) u:r_ows u:n_ext r
}
7 u:r_ows 7 t_ake 1

# -- Binomial coefficients ----------------------------------------------------
# Row n, item k is n choose k. The table of every k against every n
# (APL's k outer-product-binomial n) gives the triangle standing on its
# side: row k of the table, column n.
u:f_act := { '* r_/ r_ange _r }  # the empty product is 1, so 0 gives 1
u:c_hoose := { k n -> k > n ? 0; (u:f_act n) d_iv (u:f_act k) * u:f_act n - k }
2 u:c_hoose 5
(o_ffsets 7) 'u:c_hoose t_able o_ffsets 7

# -- The triangle as it is drawn -------------------------------------------
# Each row as text (`f_ormat`), its zeros left out, centred in a line
# three columns per item wide: take pads with spaces, a negative count
# on the left.
u:l_ine := { w r ->
  text := f_ormat (w_here r > 0) s_elect r
  pad := (w - t_ally text) d_iv 2
  w t_ake (0 - pad + t_ally text) t_ake text
}
u:t_riangle := { n r ->
  w := 3 * t_ally r
  n = 0 ? (0 c_at w) r_eshape " "
  (w u:l_ine r) c_at (n - 1) u:t_riangle u:n_ext r
}
7 u:t_riangle 7 t_ake 1

# -- Odd and even -----------------------------------------------------------
# The rows modulo 2, drawn with a star for each odd number, are
# Sierpinski's triangle: 1 plus each bit picks a space or a star.
(1 + (16 u:r_ows 16 t_ake 1) m_od 2) s_elect " *"

# -- Drawn -------------------------------------------------------------------
# The same as pictures ("just draw demos/classics/pascal.xtl" opens the
# first): 32 rows modulo 2 as dark and light cells, and the binomials of
# 0 to 11 colored by size, from dark purple (0) to yellow (462).
sierpinski := []S_HOW []G_RID (32 u:r_ows 32 t_ake 1) m_od 2
binomials := []S_HOW []G_RID (o_ffsets 12) 'u:c_hoose t_able o_ffsets 12

# -- Ragged rows ------------------------------------------------------------
# With nested arrays each row keeps its own length: m_ap gives one box
# per row (row k is the binomials of k - 1, by u:c_hoose), and the boxes
# set in a column are the triangle as it is usually written.
rows := '{ k -> (o_ffsets k) 'u:c_hoose e_ach k - 1 } m_ap r_ange 7
7 1 r_eshape rows
'{ '+ r_/ d_isclose _r } e_ach rows      # each row sums to a power of 2
