#!/usr/bin/env xetal
# Sequences the array way: polynomials evaluated by Horner's rule as a
# reduction, finite differences by dropping one end, and moving averages
# by windows or by differences of a running sum.

# -- Polynomials ---------------------------------------------------------------
# The coefficients, constant first: 1 - 3x + 2x^3. Horner's rule is a
# right fold, a0 + x * (a1 + x * (a2 + x * a3)), and so a reduction;
# with x a vector, every value at once.
c := 1 -3 0 2
u:h_orner := { c x -> '{ a b -> a + x * b } r_/ c }
c u:h_orner 2
c u:h_orner -2 -1 0 1 2 3

# The same as the sum of each coefficient times its power of x.
u:b_yPowers := { c x -> '+ r_/ c * x ^ o_ffsets t_ally c }
c u:b_yPowers 2

# -- Finite differences ------------------------------------------------------------
# Each item less the one before: drop the first, drop the last,
# subtract. Almost absurdly natural in APL.
u:d_iff := { v -> (1 d_rop v) - -1 d_rop v }
squares := (r_ange 8) ^ 2
squares
u:d_iff squares               # the odd numbers
u:d_iff^2 squares             # a constant: squares are degree 2
u:d_iff^3 (r_ange 8) ^ 3      # 6 = 3!, for cubes

# The differences of the polynomial above, at 0 to 7: the third is
# 12 = 2 * 3!, its leading coefficient times 3!.
u:d_iff^3 c u:h_orner o_ffsets 8

# -- Moving averages ---------------------------------------------------------------
# Every window of n items, as a table of start against offset, then
# the mean of each row.
v := 3 5 4 8 7 9 12 10 14 13
u:w_indows := { n v ->
  (r_ange 1 + (t_ally v) - n) '{ i j -> (i + j - 1) s_elect v } t_able r_ange n
}
3 u:w_indows v
(f_loat '+ r_/_2 3 u:w_indows v) / 3

# Or without the table: window sums are differences of the running sum
# n apart (with a 0 in front), the way APL usually writes it.
u:m_oving := { n v ->
  s := 0 c_at '+ s_\ v
  (f_loat (n d_rop s) - (0 - n) d_rop s) / f_loat n
}
3 u:m_oving v
