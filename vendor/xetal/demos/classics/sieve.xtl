#!/usr/bin/env xetal
# The sieve of Eratosthenes: no loop over the numbers, only masks. Take
# the first of what is left, a prime; keep the rest that it does not
# divide (`m_od` is the remainder, `w_here` the places of the 1s in a
# mask, `s_elect` picks those items); sieve again. Once a prime squared
# passes the largest number, everything left is prime.
u:s_ieve := { v ->
  0 = t_ally v ? v
  p := f_irst v
  (p * p) > 'm_ax r_/ v ? v
  rest := 1 d_rop v
  p c_at u:s_ieve (w_here 0 != rest m_od p) s_elect rest
}
u:s_ieve 1 d_rop r_ange 100

# One round of it, as masks: the numbers 2 to 30 that 3 does not divide.
v := 1 d_rop r_ange 30
0 != v m_od 3
(w_here 0 != v m_od 3) s_elect v

# How many primes below 1000, and the last of them.
p := u:s_ieve 1 d_rop r_ange 1000
t_ally p
-1 t_ake p
