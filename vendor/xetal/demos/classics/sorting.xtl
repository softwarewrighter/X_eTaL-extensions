#!/usr/bin/env xetal
# Sorting the APL way separates grading from indexing: `g_rade v` says
# in which order to take the items (the indices that sort), and
# `s_elect` takes them, so one grade can sort many things.
v := 30 10 50 20 40
g_rade v
(g_rade v) s_elect v
s_ort v                          # the same, in one step
r_ev s_ort v                     # descending

# Sorting one thing by another: names by age (a Char matrix, row by row).
names := 4 5 r_eshape "Alicebob  carolDave "
ages := 34 27 45 19
(g_rade ages) s_elect names
(g_rade ages) s_elect ages

# The rank of each item: the grade of the grade.
g_rade g_rade v

# Removing duplicates: u_nique keeps the first of each, in order. The
# mask of first occurrences says the same thing: an item is a first
# when its index-of is its own place.
w := 3 1 4 1 5 9 2 6 5 3 5
u_nique w
(w i_ndexOf w) = r_ange t_ally w
(w_here (w i_ndexOf w) = r_ange t_ally w) s_elect w

# And which values occur more than once.
s := s_ort u_nique w
(w_here 1 < '+ r_/_2 s '= t_able w) s_elect s
