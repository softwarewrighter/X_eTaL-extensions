#!/usr/bin/env xetal
# The Combinators library: Smullyan's birds, each a function that only
# rearranges, repeats or drops its arguments. Run as a notebook with
# "just show demos/combinators.xtl"; docs/birds.md lists every bird.
"c:" u_se< "Combinators"

# A quoted function before a bird is its first argument; a value on
# the left comes next, then the one on the right.
u:i_nc := { _r + 1 }
u:d_ouble := { _r * 2 }

# K keeps its first argument and drops the second.
1 c:K_ 2

# C, the Cardinal, swaps the arguments of a function: 10 - 3 becomes
# 3 - 10.
10 '- c:C_ 3

# B, the Bluebird, composes: double first, then add one.
'u:d_ouble 'u:i_nc c:B_ 5

# W, the Warbler, duplicates an argument: 4 * 4.
'* c:W_ 4

# S, the Starling: x z (y z), here 3 + (3 * 2).
'u:d_ouble '+ c:S_ 3

# T, the Thrush, applies its second argument to its first.
3 c:T_ 'u:d_ouble

# V, the Vireo, holds a pair until a function arrives.
(3 c:V_ 4)_ '+
(3 c:V_ 4)_ '*

# Y, the Sage Bird: a function that calls itself, from one that is
# handed itself. The factorial gets its own recursion from Y.
u:f_act := { ~s_elf n -> n <= 1 ? 1; n * s_elf n - 1 }
'u:f_act c:Y_ 10

# Function power: a superscript repeats a function.
u:d_ouble^10 1
