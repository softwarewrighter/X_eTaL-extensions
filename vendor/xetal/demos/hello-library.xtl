#!/usr/bin/env xetal
# demos/hello-library.xtl: a program using two libraries of its own,
# userlibs/Hello.xtl and userlibs/Greetings.xtl. u_se< finds "Hello" as
# Hello.xtl beside this file, then in userlibs/ (run from the
# repository's root), then on XETAL_PATH, then among the standard
# libraries; the string on its left is the prefix the library's l:
# names get here.

"h:" u_se< "Hello"
"g:" u_se< "Greetings"

# h_ello is niladic: it takes Unit (@), the value that stands for
# nothing, and gives the greeting.
h:h_ello @

# g_reet is monadic: this program supplies the greeting.
g:g_reet "hi"
g:g_reet "welcome to"
