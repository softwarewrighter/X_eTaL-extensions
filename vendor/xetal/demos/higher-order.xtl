#!/usr/bin/env xetal
# M4: higher-order built-ins take quoted functions as operands.
v := 3 1 4 1 5
'+ r_/ v
'- r_/ 1 2 3
'+ s_\ v
m := 2 3 r_eshape r_ange 6
'+ r_/ m
1 2 3 '* t_able 1 2 3
m '+ '* i_nner 1 1 1
u:s_ign := { x -> x < 0 ? -1; x = 0 ? 0; 1 }
'u:s_ign e_ach -2 0 7
1 2 3 '= e_ach 1 5 3
'n_eg 'a_bs c_ompose -3 4
2 '/ s_wap 1
s_ort v
g_rade v
u_nique v
v i_ndexOf 4 9
w_here v > 2
