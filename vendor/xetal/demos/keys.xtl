#!/usr/bin/env xetal
# demos/keys.xtl: every way X_eTaL is typed. Each line of code appears
# twice: drawn decorated, as "just pp demos/keys.xtl" shows it, and at
# the end of the line, after "typed:", exactly the keys you type (a
# comment is drawn as written, so that text stays plain ASCII).
# "just show demos/keys.xtl" runs every line and shows its result.
# docs/input.md explains each form.

# == Names and bindings ================================================

# A variable is a plain name. := binds it; it is drawn as a left arrow.
x := 5                                  # typed: x := 5

# A variable whose name ends in ! may be bound again (mutation); the !
# is part of the name wherever it is used.
count! := 0                             # typed: count! := 0
count! := count! + 1                    # typed: count! := count! + 1

# A function name has exactly one underline, typed as _ right after a
# letter: r_ev is the function "rev" with its r underlined (reverse).
r_ev 1 2 3                              # typed: r_ev 1 2 3

# u: puts a name in your program's own namespace (drawn as a raised
# u). Inside { }, _r is the right argument (drawn as APL's omega).
u:s_quare := { _r * _r }                # typed: u:s_quare := { _r * _r }
u:s_quare 7                             # typed: u:s_quare 7

# == Reduce, scan, rotate and reverse, and their axes ==================

# M is a matrix of 2 rows and 3 columns: 1 2 3 above 4 5 6. Axis 1
# runs down the rows (its length is 2), axis 2 along a row (length 3).
M := 2 3 r_eshape r_ange 6              # typed: M := 2 3 r_eshape r_ange 6

# Reduce, r_/ (APL's /), combines items with a function given to it
# quoted: '+ is plus as a value. With no subscript it works along the
# first axis, adding the rows together: 1+4, 2+5, 3+6.
'+ r_/ M                                # typed: '+ r_/ M

# The same with the axis written out: _1 after a function name is
# axis 1, which is the default, so the result is the same.
'+ r_/_1 M                              # typed: '+ r_/_1 M

# Axis 2 instead: each row summed along its length: 1+2+3 and 4+5+6.
'+ r_/_2 M                              # typed: '+ r_/_2 M

# Two digits are two axes: _12 reduces axis 1 and then axis 2, the
# whole matrix: 21.
'+ r_/_12 M                             # typed: '+ r_/_12 M

# Any function of two arguments reduces: the largest of each row.
'm_ax r_/_2 M                           # typed: 'm_ax r_/_2 M

# Scan, s_\ (APL's \), keeps each running result instead of only the
# last: by default down the rows (row 2 becomes row 1 + row 2) ...
'+ s_\ M                                # typed: '+ s_\ M

# ... the same with axis 1 written out ...
'+ s_\_1 M                              # typed: '+ s_\_1 M

# ... and along each row with axis 2: 1, 1+2, 1+2+3.
'+ s_\_2 M                              # typed: '+ s_\_2 M

# Rotate, o_- (APL's rotate), shifts items round by an amount on its
# left. By default the rows move: row 2 comes first.
1 o_- M                                 # typed: 1 o_- M

# The same with axis 1 written out.
1 o_-_1 M                               # typed: 1 o_-_1 M

# Axis 2 shifts within each row: 2 3 1 and 5 6 4.
1 o_-_2 M                               # typed: 1 o_-_2 M

# A negative amount shifts the other way.
-1 o_- 1 2 3                            # typed: -1 o_- 1 2 3

# A list of amounts gives one result for each, as rows.
-1 0 1 o_- 1 2 3                        # typed: -1 0 1 o_- 1 2 3

# Reverse, r_ev: by default the order of the rows ...
r_ev M                                  # typed: r_ev M

# ... the same with axis 1 written out ...
r_ev_1 M                                # typed: r_ev_1 M

# ... and with axis 2, each row reversed.
r_ev_2 M                                # typed: r_ev_2 M

# == Powers ============================================================

# ^ touching a value, then a number, is an exponent (a superscript).
x^2                                     # typed: x^2

# A decimal exponent is raised too, its point drawn as a raised dot:
# the power 0.5 is the square root, of every item.
(1 9 25)^0.5                            # typed: (1 9 25)^0.5

# A spaced ^ is the power function; use it for a computed power.
x ^ 3                                   # typed: x ^ 3

# ^ touching a function name, then a whole number, applies the
# function that many times: n_eg (negate) three times.
n_eg^3 5                                # typed: n_eg^3 5

# == Numbers and minus =================================================

# A minus touching a number makes it negative: three numbers.
-1 0 1                                  # typed: -1 0 1

# A spaced minus subtracts.
3 - 1                                   # typed: 3 - 1

# A space before the minus but not after: 3 and negative 1, two
# numbers ("3-1", with no spaces, is an error: it is ambiguous).
3 -1                                    # typed: 3 -1

# x minus negative 3.
x - -3                                  # typed: x - -3

# A decimal number, and *, drawn as the times sign.
2.5 * 2                                 # typed: 2.5 * 2

# == Comparisons and logic =============================================

# != is "not equal", drawn as the not-equal sign.
x != 3                                  # typed: x != 3

# <= is "at most", drawn as the less-or-equal sign.
x <= 5                                  # typed: x <= 5

# & is "and", | is "or". Everything reads right to left with no
# precedence, so the comparison on the left needs its parentheses.
(x > 1) & x < 9                         # typed: (x > 1) & x < 9
(x < 1) | x > 9                         # typed: (x < 1) | x > 9

# == Functions of your own =============================================

# Inside { }, _l is the left argument (drawn as APL's alpha) and _r
# the right: this function takes two arguments.
u:a_dd := { _l + _r }                   # typed: u:a_dd := { _l + _r }

# A function of two arguments is written between them.
2 u:a_dd 3                              # typed: 2 u:a_dd 3

# n -> names the argument n. "c ? r" is a guard: when c holds, the
# result is r; statements are separated by ; (drawn as a diamond).
u:s_ign := { n -> n < 0 ? -1; n = 0 ? 0; 1 }
# typed: u:s_ign := { n -> n < 0 ? -1; n = 0 ? 0; 1 }
u:s_ign -4                              # typed: u:s_ign -4

# A quoted lambda is a function passed as a value: e_ach applies it to
# every item.
'{ _r * 10 } e_ach 1 2                  # typed: '{ _r * 10 } e_ach 1 2

# Three functions in square brackets are a train (a fork): the sum
# divided by the count, which is the mean.
u:m_ean := ['+ r_/ / t_ally]            # typed: u:m_ean := ['+ r_/ / t_ally]
u:m_ean 1 2 3 4                         # typed: u:m_ean 1 2 3 4

# == Strings, Unit and statements ======================================

# Text in double quotes is a string, a vector of characters; c_at
# joins two.
"hello" c_at " world"                   # typed: "hello" c_at " world"

# @ is Unit, the value that stands for "nothing"; it has 1 item.
t_ally @                                # typed: t_ally @

# ; separates two statements on one line (drawn as a diamond).
1 + 1; 2 + 2                            # typed: 1 + 1; 2 + 2

# == Libraries and system names ========================================

# A library is imported with u_se< (a macro, drawn bold): the left
# string is the prefix its names get here, the right one its name. The
# import is drawn as a raised c and a raised equals sign.
"c:" u_se< "Combinators"                # typed: "c:" u_se< "Combinators"

# The library's names, written with that prefix: K keeps its first
# argument.
1 c:K_ 2                                # typed: 1 c:K_ 2

# f_ormat gives a value as the text it prints as.
f_ormat 3.5                             # typed: f_ormat 3.5

# [] touching an uppercase name is a system name (drawn as APL's quad):
# []N_PUT writes the text on its left to the file on its right and
# gives how many characters it wrote.
"hi" []N_PUT "work/keys.txt"            # typed: "hi" []N_PUT "work/keys.txt"
