#!/usr/bin/env xetal
# Magmas: a set with a binary operation that stays in the set, and
# nothing more is promised. Rock-paper-scissors is one: x played against
# y gives the winner (x on a tie). With its table we can ask which laws
# hold, for every case at once.
u:r_ps := { x y -> d := (x - y) m_od 3; y + (x - y) * d <= 1 }
names := "rock" "paper" "scissors"
t := (r_ange 3) 'u:r_ps t_able r_ange 3
t                                   # the Cayley table: 1 rock, 2 paper, 3 scissors
t s_elect names                     # the same, by name

# The laws, as checks over the whole table. Associativity needs every
# triple x y z: the digits of 0 to n^3 - 1 in base n, by e_ncode.
u:c_ommutative := { f_ n -> ((r_ange n) 'f_ t_able r_ange n) m_atch (r_ange n) '{ _r f_ _l } t_able r_ange n }
u:i_dempotent := { f_ n -> (r_ange n) m_atch '{ _r f_ _r } e_ach r_ange n }
u:a_ssociative := { f_ n ->
  t := 1 + (3 r_eshape n) e_ncode o_ffsets n ^ 3
  x := 1 s_elect t
  y := 2 s_elect t
  z := 3 s_elect t
  '& r_/ ((x f_ y) f_ z) = x f_ y f_ z
}
u:i_dentity := { f_ n ->                # the identity element, or 0 for none
  r := r_ange n
  e := w_here '{ (r m_atch _r f_ r) & r m_atch r f_ _r } e_ach r
  0 = t_ally e ? 0; f_irst e
}
'u:r_ps u:c_ommutative 3
'u:r_ps u:i_dempotent 3
'u:r_ps u:a_ssociative 3            # not associative
'u:r_ps u:i_dentity 3               # no identity

# Not associative means the order of play matters: rock, paper,
# scissors from the right (reduce is a right fold) and from the left.
'u:r_ps r_/ 1 2 3                   # rock vs (paper vs scissors): rock
(1 u:r_ps 2) u:r_ps 3               # (rock vs paper) vs scissors: scissors

# Two more magmas on 1 2 3, to compare: addition modulo 3 (a group:
# associative, with an identity) and subtraction modulo 3 (neither).
u:a_dd := { x y -> 1 + (x + y - 2) m_od 3 }
u:s_ub := { x y -> 1 + (x - y) m_od 3 }
'u:a_dd u:c_ommutative 3
'u:a_dd u:a_ssociative 3
'u:a_dd u:i_dentity 3               # 1 stands for 0
'u:s_ub u:c_ommutative 3
'u:s_ub u:a_ssociative 3

# Rock-paper-scissors-lizard-Spock: five moves, each beating two. In
# the order below, x beats y when (x - y) mod 5 is 1 or 2, so the rule
# is the same as before with 5 for 3 and 2 for 1.
u:r_psls := { x y -> d := (x - y) m_od 5; y + (x - y) * d <= 2 }
moves := "rock" "Spock" "paper" "lizard" "scissors"
w := (r_ange 5) 'u:r_psls t_able r_ange 5
w s_elect moves
beats := 0 + (r_ange 5) '{ (_l != _r) & _l = _l u:r_psls _r } t_able r_ange 5
beats                               # row x: the moves x beats
'+ r_/_2 beats                      # each beats two
'+ r_/ beats                        # and loses to two
'u:r_psls u:c_ommutative 5
'u:r_psls u:i_dempotent 5
'u:r_psls u:a_ssociative 5
shown := []S_HOW []G_RID w          # the winner table, colored by move
