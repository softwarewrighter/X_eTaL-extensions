#!/usr/bin/env xetal
# Rotate along both axes: every frame moves the arrow one row down and
# one column right, wrapping around the edges of the board. Frames are
# separated by a blank line ("just animate" plays them).
u:f_rames := { n b ->
  n = 0 ? n
  s := p_rint! b
  gap := p_rint! ""
  (n - 1) u:f_rames -1 o_-_12 b
}
arrow := 6 8 r_eshape ".#.......##.....###.....##......#......................."
shown := 8 u:f_rames arrow
