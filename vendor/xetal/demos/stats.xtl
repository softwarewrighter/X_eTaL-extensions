#!/usr/bin/env xetal
# Using a library: Stats is a standard library, built into xetal
# (lib/Stats.xtl). The alias "s:" is this file's name for it: its
# exported names are used as s:m_ean and so on.
"s:" u_se< "Stats"

v := 2 4 4 4 5 5 7 9
s:m_ean v                # 5.0
s:v_ariance v            # the mean squared deviation: 4.0
s:s_d v                  # the standard deviation: 2.0
s:r_ange v               # largest minus smallest: 7
s:m_ean 1.5 2.5          # the same functions work on Floats
