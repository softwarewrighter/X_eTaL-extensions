#!/usr/bin/env xetal
# TTTML, part 2: play the machine that demos/tttml-train.xtl trained
# (run that first). You are X and move first: type a square, 1 to 9,
# numbered row by row. Something that is not an empty square is asked
# for again.
"t:" u_se< "TTTML"

# The model, read back: []N_GET reads the file's text, n_umbers the
# numbers in it, and r_eshape makes the two rows again.
v := n_umbers []N_GET "work/tttml.model"
m := (2 c_at (t_ally v) d_iv 2) r_eshape v
t_ally 1 s_elect m

# Your move: a digit for an empty square, or it asks again.
u:a_sk := { s ->
  shown := p_rint! "your move (1 to 9):"
  t := []R_EAD @
  k := "123456789" i_ndexOf f_irst t c_at " "
  (k <= 9) & 0 = k s_elect s c_at 1 ? k; u:a_sk s
}

# You move, then it replies, until the game is over.
u:y_ou := { s ->
  s := s t:a_fter u:a_sk s
  shown := p_rint! t:s_how s
  gap := p_rint! ""
  0 = t:o_utcome s ? u:m_e s; s
}
u:m_e := { s ->
  s := s t:a_fter m t:c_hoose s
  shown := p_rint! t:s_how s
  gap := p_rint! ""
  0 = t:o_utcome s ? u:y_ou s; s
}
u:v_erdict := { w -> w = 1 ? "you win"; w = -1 ? "it wins"; "a draw" }

u:v_erdict t:o_utcome u:y_ou 9 r_eshape 0
