#!/usr/bin/env xetal
# TTTML: a machine that learns tic-tac-toe by playing itself, from the
# TTTML library (lib/TTTML.xtl, ported from sw-apl's TTTML workspace;
# docs/literate/tttml.org explains it). Run as a notebook with
# "just tttml" (the optimized build: training takes seconds).
"t:" u_se< "TTTML"

# A board: 1 for X, -1 for O, 0 for an empty square.
t:s_how 1 -1 0 0 1 0 0 0 -1

# Who has won: 1 X, -1 O, 2 a draw, 0 not over.
t:o_utcome 1 1 1 -1 -1 0 0 0 0
t:o_utcome 1 -1 1 1 -1 -1 -1 1 1

# A position's code is the same for the board turned or reflected.
t:c_ode 1 0 0 0 0 0 0 0 0
t:c_ode 0 0 1 0 0 0 0 0 0

# Learning from 2000 games against itself: how many positions it
# met.
m := 2000 t:t_rain! t:empty
t_ally 1 s_elect m

# 50 games against a random player as X, then 50 as O: won, lost,
# drawn.
50 t:t_rial! m

# 50 games against itself, its best move on both sides from a random
# first move: X won, O won, drawn. Played well, all are draws.
50 t:s_elfTrial! m

# The game it plays against itself, move by move.
t:b_oards t:b_est m
