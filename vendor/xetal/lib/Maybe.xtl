# Maybe: a value that may be missing, and the monad that chains
# computations which can fail (a standard library, built into xetal).
# Import it with an alias of your choice: "m:" u_se< "Maybe".
#
# A maybe is Church-encoded: it is a function of two arguments, what
# to give when it is empty and what to do with its value. n_othing
# gives the first; j_ust x applies the second to x.

l:n_othing := { n j -> n }                   # the empty maybe
l:j_ust := { x n j_ -> j_ x }                # a maybe holding x

# Like '+ r_/ A, the function comes first, as a quoted operand, so a
# chain reads right to left: 'g b_ind 'f b_ind m is f, then g.

# d 'f m_aybe m: f applied to m's value, or d when m is empty.
l:m_aybe := { f_ d m_ -> d m_ 'f_ }

# d o_r m: m's value, or d when m is empty.
l:o_r := { d m_ -> d m_ '{ x -> x } }

# 'f m_ap m: f applied inside the maybe; empty stays empty.
l:m_ap := { f_ m_ -> 'l:n_othing m_ '{ x -> l:j_ust f_ x } }

# 'f b_ind m: f (which gives a maybe) applied to m's value; empty
# stays empty, so a chain of steps stops at the first that fails.
l:b_ind := { f_ m_ -> 'l:n_othing m_ 'f_ }
